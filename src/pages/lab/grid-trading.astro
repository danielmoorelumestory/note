---
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/url';
---

<Base title="网格交易计算器" current="lab" description="按历史交易日高低价模拟 ETF 和股票网格执行">
  <header class="hero grid-hero">
    <p class="kicker">GRID BACKTEST</p>
    <h1>网格交易计算器</h1>
    <p class="lede">填写建仓参数后获取历史日线；以每个交易日的最高、最低价模拟网格触发。步长、反弹买入和回落卖出均为价格数值，不是百分比。</p>
  </header>

  <section class="notice" aria-label="计算说明">
    <span>计算口径</span>
    <p>下次买入价为上次成交价减网格步长加反弹买入；下次卖出价为上次成交价加网格步长减回落卖出。日内最低价或最高价触及对应价格即成交，不要求先跌破或突破步长线。买卖佣金各按万分之 1.5；A 股卖出另计 0.05% 印花税，ETF 免印花税。同一日同时触及买卖价时，按买入优先、每日最多一笔处理。</p>
  </section>

  <div class="toolbar">
    <div id="status" role="status">准备就绪 · 默认加载沪深 300 ETF 示例</div>
    <div class="toolbar-actions">
      <a class="button secondary" href={href('lab/grid-trading/saved')}>已保存标的</a>
      <button id="run-all" class="button" type="button">获取数据并回测</button>
    </div>
  </div>

  <div class="table-shell">
    <table class="grid-table">
      <thead><tr>
        <th>代码</th><th>名称</th><th>建仓时间</th><th>初始买入价</th><th>初始金额</th><th>网格步长</th><th>反弹买入</th><th>回落卖出</th><th>每格金额</th><th>当前价格</th><th>上次成交日期</th><th>上次成交价</th><th>预计下次买入</th><th>预计下次卖出</th><th>买 / 卖次数</th><th>最多使用本金</th><th>盈亏金额</th><th>操作</th>
      </tr></thead>
      <tbody id="grid-body"></tbody>
    </table>
  </div>

  <section class="result-panel">
    <div><span>选中标的回测摘要</span><strong id="summary-title">—</strong></div>
    <div><span>历史区间</span><strong id="summary-range">—</strong></div>
    <div><span>持仓市值</span><strong id="summary-value">—</strong></div>
    <div><span>已实现盈亏</span><strong id="summary-realized">—</strong></div>
  </section>

  <section class="chart-panel">
    <div class="chart-head"><div><h2>资金与收盘价变化曲线</h2><p>按每个交易日收盘价估值；收盘价与预计下次成交价使用右侧独立刻度</p></div><div class="legend"><span class="line position"></span>持仓市值 <span class="line capital"></span>占用本金 <span class="line profit"></span>总盈亏 <span class="line close"></span>收盘价 <span class="line buy-level"></span>预计买入 <span class="line sell-level"></span>预计卖出</div></div>
    <div class="chart-scroll"><svg id="equity-chart" viewBox="0 0 920 300" role="img" aria-label="持仓市值、占用本金、总盈亏和收盘价变化曲线"><text x="460" y="150" text-anchor="middle" fill="#94a3b8" font-size="13">完成回测后显示曲线</text></svg></div>
  </section>

  <p class="data-note">行情来源：腾讯财经公开前复权日线接口，历史价格与除权除息后的持仓成本保持可比。自动识别场内 ETF 与 A 股：买卖佣金均按成交额万分之 1.5，A 股卖出另扣 0.05% 印花税，ETF 免印花税。暂未计入最低佣金、过户费与实际成交限制。</p>
</Base>

<script>
  import {
    calculateGrid, getCandles, fetchQuotes, mergeQuote, renderEquityChart, saveRecord,
    type Candle, type GridParams, type GridResult, type SavedRecord,
  } from '../../lib/grid-trading';

  type Row = GridParams & { id: number; candles?: Candle[] };

  const body = document.querySelector('#grid-body') as HTMLTableSectionElement;
  const status = document.querySelector('#status') as HTMLElement;
  const rows: Row[] = [{ id: Date.now(), name: '沪深300ETF', code: '510300', date: '2025-01-02', initialPrice: 3.809, initialAmount: 10000, step: 0.10, rebound: 0.02, pullback: 0.02, gridAmount: 1000 }];
  const format = new Intl.NumberFormat('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const priceFormat = new Intl.NumberFormat('zh-CN', { minimumFractionDigits: 3, maximumFractionDigits: 3 });

  function number(v: string) { const n = Number(v); return Number.isFinite(n) ? n : 0; }
  function money(v: number) { return `${v >= 0 ? '+' : '-'}¥${format.format(Math.abs(v))}`; }
  function editable(row: Row, key: keyof Row, type: string, value: string | number, extra = '') {
    return `<input class="cell-input ${extra}" data-id="${row.id}" data-key="${key}" type="${type}" value="${value}">`;
  }
  function render() {
    body.innerHTML = rows.map(row => `<tr data-row="${row.id}">
      <td>${editable(row, 'code', 'text', row.code, 'code')}</td>
      <td class="stock-name">${row.name || '获取行情后自动填充'}</td>
      <td>${editable(row, 'date', 'date', row.date)}</td>
      <td>${editable(row, 'initialPrice', 'number', row.initialPrice)}</td>
      <td>${editable(row, 'initialAmount', 'number', row.initialAmount)}</td>
      <td>${editable(row, 'step', 'number', row.step)}</td>
      <td>${editable(row, 'rebound', 'number', row.rebound)}</td>
      <td>${editable(row, 'pullback', 'number', row.pullback)}</td>
      <td>${editable(row, 'gridAmount', 'number', row.gridAmount)}</td>
      <td class="computed current">—</td><td class="computed last-date">—</td><td class="computed last">—</td><td class="computed buy">—</td><td class="computed sell">—</td><td class="computed count">—</td><td class="computed max-capital">—</td><td class="computed pnl">—</td>
      <td class="row-actions"><button class="save" data-save="${row.id}" type="button">保存</button></td>
    </tr>`).join('');
    rows.forEach(updateComputed);
  }
  function calculate(row: Row): GridResult | null {
    if (!row.candles?.length || !row.initialPrice || !row.initialAmount || !row.gridAmount || !row.step) return null;
    return calculateGrid(row, row.candles);
  }
  function updateComputed(row: Row) {
    const tr = body.querySelector(`[data-row="${row.id}"]`) as HTMLTableRowElement | null;
    const result = calculate(row);
    if (!tr) return;
    const put = (selector: string, value: string) => { const el = tr.querySelector(selector); if (el) el.textContent = value; };
    if (!result) { ['.current','.last-date','.last','.buy','.sell','.count','.max-capital','.pnl'].forEach(s => put(s, '—')); return; }
    put('.current', priceFormat.format(result.current)); put('.last-date', result.lastTradeDate); put('.last', priceFormat.format(result.lastTrade)); put('.buy', priceFormat.format(result.nextBuy)); put('.sell', priceFormat.format(result.nextSell)); put('.count', `${result.buys} / ${result.sells}`); put('.max-capital', `¥${format.format(result.maxCapital)}`);
    put('.pnl', money(result.pnl));
    (tr.querySelector('.pnl') as HTMLElement).className = `computed pnl ${result.pnl >= 0 ? 'up' : 'down'}`;
    document.querySelector('#summary-title')!.textContent = `${row.name} · ${row.code}`;
    document.querySelector('#summary-range')!.textContent = result.range;
    document.querySelector('#summary-value')!.textContent = `¥${format.format(result.value)}`;
    document.querySelector('#summary-realized')!.textContent = money(result.realized);
    renderEquityChart(document.querySelector('#equity-chart') as SVGSVGElement, result.series, result.nextBuy, result.nextSell, result.trades);
  }
  async function load(row: Row) {
    const code = row.code.trim();
    if (!/^\d{6}$/.test(code)) throw new Error('请输入 6 位 A 股或 ETF 代码');
    if (!row.date?.trim()) throw new Error('请选择买入日期后再进行回测');
    // 日线按代码每天只下载一次（前复权，避免除权除息造成网格价格断层）；实时报价补齐当日行情并提供名称。
    const [candles, quotes] = await Promise.all([getCandles(code, row.date), fetchQuotes([code])]);
    const quote = quotes.get(code);
    row.name = quote?.name || row.name || code;
    row.candles = mergeQuote(candles, quote);
    if (!row.candles.length) throw new Error('没有找到该日期后的日线数据');
  }
  body.addEventListener('input', event => {
    const input = event.target as HTMLInputElement;
    const id = Number(input.dataset.id); const key = input.dataset.key as keyof Row; const row = rows.find(item => item.id === id);
    if (!row || !key) return;
    (row as any)[key] = input.type === 'number' ? number(input.value) : input.value;
    if (['code', 'date'].includes(key)) row.candles = undefined;
    updateComputed(row);
  });
  function saveRow(row: Row, btn?: HTMLButtonElement) {
    const result = calculate(row);
    if (!result) {
      alert('请先点击右上角“获取数据并回测”按钮，回测完成后即可保存标的。');
      status.textContent = '请先获取该标的的历史日线并完成回测';
      return;
    }
    const record: SavedRecord = {
      id: crypto.randomUUID(), savedAt: new Date().toISOString(),
      row: { id: row.id, name: row.name, code: row.code, date: row.date, initialPrice: row.initialPrice, initialAmount: row.initialAmount, step: row.step, rebound: row.rebound, pullback: row.pullback, gridAmount: row.gridAmount }, result,
    };
    saveRecord(record);
    status.textContent = `${row.name || row.code} 已保存，可在“已保存标的”查看详情`;
    if (btn) {
      const originalText = btn.textContent;
      btn.textContent = '已保存 ✓';
      btn.classList.add('saved');
      setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('saved');
      }, 1500);
    }
  }
  body.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest('[data-save]') as HTMLButtonElement | null;
    if (button && button.dataset.save) {
      const row = rows.find(item => item.id === Number(button.dataset.save));
      if (row) saveRow(row, button);
    }
  });
  document.querySelector('#run-all')!.addEventListener('click', async () => {
    const button = document.querySelector('#run-all') as HTMLButtonElement;
    const missingDate = rows.find(r => !r.date || !r.date.trim());
    if (missingDate) {
      alert('请选择买入日期后再获取数据并回测');
      status.textContent = '回测未开始：请先选择买入日期';
      return;
    }
    button.disabled = true; status.textContent = '正在获取日线并回测…';
    const outcomes = await Promise.allSettled(rows.map(load));
    outcomes.forEach((outcome, i) => { if (outcome.status === 'rejected') status.textContent = `${rows[i].code || '该标的'}：${outcome.reason.message}`; });
    render(); const successful = outcomes.filter(o => o.status === 'fulfilled').length;
    if (successful) status.textContent = `已完成 ${successful} 个标的的历史日线回测`;
    button.disabled = false;
  });
  render();
</script>

<style>
  .grid-hero { margin-bottom: 1.4rem; }
  .notice { display:flex; gap:12px; align-items:flex-start; margin-bottom:20px; padding:13px 16px; border:1px solid #bae6fd; border-radius:10px; background:#f0f9ff; color:#475569; font-size:13px; line-height:1.65; }
  .notice span { flex:none; padding:2px 7px; border-radius:4px; color:#0369a1; background:#e0f2fe; font-size:12px; font-weight:700; }
  .notice p { margin:0; }
  .toolbar { display:flex; justify-content:space-between; gap:16px; align-items:center; margin-bottom:14px; color:#64748b; font-size:13px; }
  .toolbar-actions { display:flex; gap:8px; flex:none; }
  .button { border:0; border-radius:7px; padding:9px 13px; background:#0369a1; color:#fff; font-size:13px; font-weight:600; cursor:pointer; box-shadow:0 1px 2px rgb(15 23 42 / .12); }
  .button:hover { background:#075985; }.button:disabled { opacity:.55; cursor:wait; }.button.secondary { border:1px solid #cbd5e1; background:#fff; color:#334155; box-shadow:none; }
  .table-shell {
    overflow-x: auto;
    overflow-y: hidden;
    min-height: 160px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: white;
    box-shadow: 0 1px 3px rgb(15 23 42 / .04);
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }
  .table-shell::-webkit-scrollbar { height: 6px; width: 6px; }
  .table-shell::-webkit-scrollbar-track { background: transparent; }
  .table-shell::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 3px; }
  .table-shell::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }
  .result-panel { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; overflow:hidden; margin-top:16px; border:1px solid #e2e8f0; border-radius:10px; background:#e2e8f0; }.result-panel div { min-height:74px; padding:13px 16px; background:#fff; }.result-panel span { display:block; margin-bottom:5px; color:#94a3b8; font-size:12px; }.result-panel strong { color:#1e293b; font-size:14px; font-variant-numeric:tabular-nums; }.data-note { margin:14px 2px 0; color:#94a3b8; font-size:12px; line-height:1.65; }
  .chart-panel { margin-top:16px; padding:18px; border:1px solid #e2e8f0; border-radius:10px; background:#fff; }.chart-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:8px; }.chart-head h2 { margin:0 0 3px; color:#1e293b; font-size:16px; }.chart-head p { margin:0; color:#94a3b8; font-size:12px; }.legend { display:flex; flex-wrap:wrap; gap:7px; align-items:center; color:#64748b; font-size:12px; }.line { display:inline-block; width:14px; height:2px; margin-left:5px; }.line.position { background:#2563eb; }.line.capital { background:#f59e0b; }.line.profit { background:#dc2626; }.line.close { background:#7c3aed; }.line.buy-level { border-top:2px dashed #16a34a; }.line.sell-level { border-top:2px dashed #ea580c; }.chart-scroll { overflow-x:auto; }.chart-scroll svg { display:block; width:100%; min-width:680px; height:auto; }.chart-hit-area { fill:transparent; cursor:crosshair; }.crosshair-v,.crosshair-h { stroke:#64748b; stroke-width:1; stroke-dasharray:3 3; pointer-events:none; }.crosshair-dot { stroke:#fff; stroke-width:2; pointer-events:none; }.crosshair-dot.position { fill:#2563eb; }.crosshair-dot.capital { fill:#f59e0b; }.crosshair-dot.profit { fill:#dc2626; }.chart-tooltip { pointer-events:none; }.chart-tooltip rect { fill:#0f172a; fill-opacity:.94; rx:6; }.chart-tooltip text { fill:#f8fafc; font-size:10px; font-variant-numeric:tabular-nums; }.chart-tooltip .tooltip-date { font-weight:700; }
  @media (max-width:640px) { .toolbar { align-items:flex-start; flex-direction:column; }.toolbar-actions { width:100%; }.button { flex:1; }.result-panel { grid-template-columns:repeat(2,1fr); }.notice { flex-direction:column; gap:6px; } }
</style>

<style is:global>
  .grid-table { width: max-content; min-width: 100%; border-collapse: collapse; font-size: 12px; }
  .grid-table th { height: 46px; padding: 12px 12px; border-bottom: 1px solid #cbd5e1; background: #f8fafc; color: #475569; font-weight: 600; white-space: nowrap; text-align: center; }
  .grid-table td { height: 58px; padding: 8px 12px; border-bottom: 1px solid #f1f5f9; white-space: nowrap; text-align: center; vertical-align: middle; color: #334155; font-variant-numeric: tabular-nums; }
  .grid-table tbody tr { transition: background-color .15s ease; }
  .grid-table tbody tr:hover { background-color: #f8fafc; }
  .grid-table tr:last-child td { border-bottom: 0; }
  .grid-table .stock-name { min-width: 110px; color: #475569 !important; text-align: center; }
  .grid-table .cell-input { box-sizing: border-box; display: inline-block; margin: 0 auto; width: 80px; height: 34px; border: 1px solid #e2e8f0; border-radius: 6px; padding: 4px 8px; background: #f8fafc; color: #0f172a; font: inherit; text-align: center; outline: none; transition: all .15s ease; }
  .grid-table .cell-input:hover { border-color: #cbd5e1; background: #fff; }
  .grid-table .cell-input:focus { border-color: #0284c7; background: #fff; box-shadow: 0 0 0 2px rgba(2, 132, 199, .15); }
  .grid-table .cell-input[type=date] { width: 134px; text-align: center; }
  .grid-table .cell-input[type=date]::-webkit-date-and-time-value { text-align: center; }
  .grid-table .cell-input[type=text] { width: 88px; text-align: center; }
  .grid-table .cell-input.code { width: 80px; font-family: ui-monospace, monospace; font-weight: 500; }
  .grid-table i { margin-left: 2px; color: #94a3b8; font-style: normal; }
  .grid-table .computed { min-width: 84px; text-align: center; }
  .grid-table .up { color: #dc2626 !important; font-weight: 700; }
  .grid-table .down { color: #16a34a !important; font-weight: 700; }
  .grid-table .row-actions { min-width: 88px; text-align: center; }
  .grid-table .save { display: inline-flex; align-items: center; justify-content: center; border: 1px solid #bae6fd; border-radius: 6px; padding: 5px 14px; background: #f0f9ff; color: #0369a1; font-size: 12px; font-weight: 600; cursor: pointer; transition: all .15s ease; user-select: none; position: relative; z-index: 1; }
  .grid-table .save:hover { background: #e0f2fe; border-color: #7dd3fc; }
  .grid-table .save:active { transform: scale(0.96); }
  .grid-table .save.saved { background: #f0fdf4 !important; border-color: #86efac !important; color: #16a34a !important; }
</style>
