---
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/url';

const calculatorUrl = href('lab/grid-trading');
const detailUrl = href('lab/grid-trading/detail');
---

<Base title="已保存标的" current="lab" description="已保存的网格回测结果">
  <header class="hero compact-hero">
    <p class="kicker">SAVED BACKTESTS</p>
    <h1>已保存标的</h1>
    <p class="lede">保存在当前浏览器。点击详情可查看每次建仓、买入和卖出的历史记录。</p>
  </header>
  <div class="actions"><a class="btn-back" href={calculatorUrl}>← 返回计算器</a><span id="market-status" class="market-status" role="status"></span><button id="clear" class="btn-clear" type="button">清空全部</button></div>
  <section class="sync-panel" aria-label="云端同步">
    <div><strong>云端同步</strong><p>在另一台设备输入同一同步密钥，即可访问同一份回测记录；删除记录会自动同步到云端。</p></div>
    <label>同步密钥 <input id="sync-key" type="text" autocomplete="off" spellcheck="false"></label>
    <button id="copy-sync-key" type="button">复制密钥</button>
    <button id="sync-records" class="sync-primary" type="button">同步云端</button>
    <span id="sync-status" role="status"></span>
  </section>
  <div id="content-area" data-detail-url={detailUrl} data-calc-url={calculatorUrl}></div>
</Base>

<script>
  import {
    readRecords, writeRecords, saveRecord, refreshRecord, refreshRecords, removeRecords, syncAll, pushRecord, withParamChange,
    gridStatus, openingOf, formatMoney, formatPrice, tick, marketSessionOpen, marketToday, SYNC_KEY_STORAGE,
    blockCopy,
    type SavedRecord,
  } from '../../../lib/grid-trading';

  blockCopy(); // 屏蔽页面内容复制

  const container = document.querySelector('#content-area') as HTMLElement;
  const detailUrl = container.dataset.detailUrl!;
  const calcUrl = container.dataset.calcUrl!;
  const marketStatus = document.querySelector('#market-status') as HTMLElement;
  const formatInt = new Intl.NumberFormat('zh-CN', { maximumFractionDigits: 0 });
  const lastBuyDate = (item: SavedRecord) => [...(item.result.trades ?? [])].reverse().find(trade => trade.side === '买入')?.date ?? '—';
  const currentCapital = (item: SavedRecord) => {
    const trades = item.result.trades ?? [];
    if (!trades.length) return item.row.initialAmount;
    let capital = 0;
    for (const [index, trade] of trades.entries()) {
      if (typeof trade.capitalUsed === 'number') capital = trade.capitalUsed;
      else if (index === 0) capital = trade.amount ?? item.row.initialAmount;
      else capital += trade.side === '买入' ? (trade.amount ?? 0) : -(trade.amount ?? 0);
    }
    return capital;
  };
  // 状态排序：先按方向分两组（离买入价近的在上、离卖出价近的在下，无状态的垫底），组内按距离的绝对值排序。
  const statusKey = (item: SavedRecord) => { const status = gridStatus(item); return { group: status ? (status.tone === 'buy' ? 0 : 1) : 2, distance: status ? Math.abs(status.gap) : 0 }; };
  type SortField = 'status' | 'last-buy' | 'capital' | 'pnl';
  let sortField: SortField | null = null;
  let sortOrder: 'asc' | 'desc' = 'desc';
  const sortMark = (field: SortField) => sortField === field ? (sortOrder === 'asc' ? ' ↑' : ' ↓') : '';
  const syncInput = document.querySelector('#sync-key') as HTMLInputElement;
  const syncStatus = document.querySelector('#sync-status') as HTMLElement;
  const storedSyncKey = localStorage.getItem(SYNC_KEY_STORAGE);
  syncInput.value = storedSyncKey || `${crypto.randomUUID()}${crypto.randomUUID().replaceAll('-', '')}`;
  if (!storedSyncKey) localStorage.setItem(SYNC_KEY_STORAGE, syncInput.value);

  function statusCell(item: SavedRecord) {
    const status = gridStatus(item);
    if (!status) return '<td class="status-cell">—</td>';
    return `<td class="status-cell"><span class="status-badge ${status.tone}${status.reached ? ' reached' : ''}">${status.label}</span><span class="status-detail">${status.detail}</span></td>`;
  }

  // 可编辑的网格参数：价格数值 + 占当前价格的百分比；修改后出现“确认”按钮，确认后只影响之后的下一笔成交。
  type ParamField = 'step' | 'rebound' | 'pullback';
  const paramLabels: Record<ParamField, string> = { step: '网格步长', rebound: '反弹买入', pullback: '回落卖出' };
  const ratioText = (value: number, current: number) => current > 0 ? `${(value / current * 100).toFixed(2)}%` : '';
  function paramCell(item: SavedRecord, field: ParamField) {
    const value = item.row[field], current = item.result.current;
    return `<td class="param-cell"><input class="param-input" type="number" step="0.001" min="0" inputmode="decimal" value="${value}" data-id="${item.id}" data-field="${field}" data-original="${value}" data-current="${current}" aria-label="${item.row.code} ${paramLabels[field]}"><span class="ratio">${ratioText(value, current)}</span><button type="button" class="confirm-param" hidden>确认</button></td>`;
  }
  const paramInputOf = (target: EventTarget | null) => (target as HTMLElement).closest('.param-input') as HTMLInputElement | null;
  const confirmOf = (input: HTMLInputElement) => input.closest('td')!.querySelector('.confirm-param') as HTMLButtonElement;
  const validParam = (field: ParamField, value: number) => Number.isFinite(value) && (field === 'step' ? value > 0 : value >= 0);

  async function applyParam(id: string, field: ParamField, value: number) {
    const record = readRecords().find(item => item.id === id);
    if (!record) return;
    marketStatus.textContent = '正在按新参数重新计算…';
    try {
      // 新参数只对下一笔生效：withParamChange 记录旧参数的截止日，重算时此前的成交保持不变。
      const updated = await refreshRecord(withParamChange(record, { [field]: value }));
      saveRecord(updated);
      render();
      marketStatus.textContent = '参数已保存，正在同步到云端…';
      const notice = await pushRecord(updated);
      marketStatus.textContent = notice || '参数已保存并同步到云端';
    } catch {
      marketStatus.textContent = '行情获取失败，参数未保存，请稍后重试';
      render();
    }
  }

  function sortRecords(records: SavedRecord[]) {
    if (!sortField) return records;
    const direction = sortOrder === 'asc' ? 1 : -1;
    return [...records].sort((a, b) => {
      if (sortField === 'last-buy') {
        const aDate = lastBuyDate(a), bDate = lastBuyDate(b);
        if (aDate === '—' || bDate === '—') return aDate === bDate ? 0 : aDate === '—' ? 1 : -1;
        return aDate.localeCompare(bDate) * direction;
      }
      if (sortField === 'status') { const x = statusKey(a), y = statusKey(b); return x.group - y.group || (x.distance - y.distance) * direction; }
      return (sortField === 'capital' ? currentCapital(a) - currentCapital(b) : a.result.pnl - b.result.pnl) * direction;
    });
  }

  function render() {
    const records = readRecords();
    if (!records.length) {
      container.innerHTML = `
        <div class="empty">
          <div class="empty-icon">📊</div>
          <h3>暂无已保存的回测记录</h3>
          <p>在网格交易计算器完成回测后，点击标的行右侧的“保存”即可将结果存入此处。</p>
          <a class="button" href="${calcUrl}">去计算器回测</a>
        </div>
      `;
      return;
    }
    container.innerHTML = `
      <div class="table-shell">
        <table class="grid-table">
          <thead>
            <tr>
              <th>代码</th>
              <th>名称</th>
              <th><button class="sort-button" data-sort="status" type="button">当前状态${sortMark('status')}</button></th>
              <th>当前价格</th>
              <th>预计下次买入</th>
              <th>预计下次卖出</th>
              <th><button class="sort-button" data-sort="last-buy" type="button">上次买入时间${sortMark('last-buy')}</button></th>
              <th>上次成交价</th>
              <th>网格步长</th>
              <th>反弹买入</th>
              <th>回落卖出</th>
              <th>每格金额</th>
              <th>建仓时间</th>
              <th>初始买入价</th>
              <th>初始金额</th>
              <th>买 / 卖次数</th>
              <th><button class="sort-button" data-sort="capital" type="button">当前使用本金${sortMark('capital')}</button></th>
              <th><button class="sort-button" data-sort="pnl" type="button">盈亏金额${sortMark('pnl')}</button></th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${sortRecords(records).map(item => `
              <tr data-id="${item.id}">
                <td class="code-cell">${item.row.code}</td>
                <td class="stock-name">${item.row.name || item.row.code}</td>
                ${statusCell(item)}
                <td class="computed">${formatPrice(item.result.current)}</td>
                <td class="computed down">${formatPrice(item.result.nextBuy)}</td>
                <td class="computed up">${formatPrice(item.result.nextSell)}</td>
                <td>${lastBuyDate(item)}</td>
                <td class="computed">${formatPrice(item.result.lastTrade)}</td>
                ${paramCell(item, 'step')}
                ${paramCell(item, 'rebound')}
                ${paramCell(item, 'pullback')}
                <td>¥${formatInt.format(item.row.gridAmount)}</td>
                <td>${item.row.date}</td>
                <td>${openingOf(item).price}</td>
                <td>¥${openingOf(item).amount.toLocaleString('zh-CN', { maximumFractionDigits: 2 })}</td>
                <td class="computed">${item.result.buys} / ${item.result.sells}</td>
                <td class="computed">¥${formatInt.format(currentCapital(item))}</td>
                <td class="computed pnl ${item.result.pnl >= 0 ? 'up' : 'down'}">${formatMoney(item.result.pnl)}</td>
                <td class="row-actions">
                  <button class="btn-delete" data-id="${item.id}" type="button">删除</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;
  }

  // 打开页面先显示已保存快照，再批量刷新行情：所有标的的实时报价合并为一次请求，日线按代码每天只下载一次。
  async function refreshMarket() {
    const records = readRecords();
    if (!records.length) return;
    marketStatus.textContent = '正在刷新行情…';
    const updated = await refreshRecords(records);
    // 刷新期间可能有删除、同步或参数修改：只回写仍存在且未被改动（updatedAt 一致）的记录，避免用旧结果覆盖新修改。
    const byId = new Map(updated.map(item => [item.id, item]));
    writeRecords(readRecords().map(item => { const fresh = byId.get(item.id); return fresh && fresh.updatedAt === item.updatedAt ? fresh : item; }));
    // 正在输入参数时不重绘，避免丢失未确认的输入。
    if (!container.querySelector('.param-input.dirty')) render();
    const hasTodayQuote = updated.some(item => item.result.series?.at(-1)?.date === marketToday());
    const source = marketSessionOpen() && hasTodayQuote ? '盘中实时行情' : '最近收盘价';
    marketStatus.textContent = `${source} · 更新于 ${new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}`;
  }

  async function syncRecords({ afterDelete = false } = {}) {
    const token = syncInput.value.trim();
    if (token.length < 16) { syncStatus.textContent = afterDelete ? '已在本机删除；同步密钥不足 16 位，未同步到云端。' : '同步密钥至少需要 16 位。'; return; }
    const button = document.querySelector('#sync-records') as HTMLButtonElement;
    button.disabled = true; syncStatus.textContent = afterDelete ? '正在同步删除到云端…' : '正在同步…';
    try {
      const records = await syncAll(token);
      render();
      syncStatus.textContent = afterDelete ? `删除已同步到云端，现有 ${records.length} 条记录。` : `同步完成，共 ${records.length} 条记录。`;
      // 云端带来的新记录可能是其它设备的旧快照，同步后按最新行情重算一次。
      if (!afterDelete) void refreshMarket();
    } catch {
      syncStatus.textContent = afterDelete ? '已在本机删除，但同步云端失败；稍后点击“同步云端”即可补同步。' : '同步失败，请检查网络和同步密钥。';
    } finally { button.disabled = false; }
  }

  function remove(ids: string[]) {
    removeRecords(ids);
    render();
    void syncRecords({ afterDelete: true });
  }

  container.addEventListener('input', event => {
    const input = paramInputOf(event.target);
    if (!input) return;
    const field = input.dataset.field as ParamField, value = Number(input.value);
    const changed = validParam(field, value) && tick(value) !== tick(Number(input.dataset.original));
    input.classList.toggle('dirty', changed);
    confirmOf(input).hidden = !changed;
    (input.nextElementSibling as HTMLElement).textContent = Number.isFinite(value) ? ratioText(value, Number(input.dataset.current)) : '';
  });
  container.addEventListener('keydown', event => {
    const input = paramInputOf(event.target);
    if (!input) return;
    const button = confirmOf(input), key = (event as KeyboardEvent).key;
    if (key === 'Enter' && !button.hidden) button.click();
    if (key === 'Escape') {
      input.value = input.dataset.original!; input.classList.remove('dirty'); button.hidden = true;
      (input.nextElementSibling as HTMLElement).textContent = ratioText(Number(input.dataset.original), Number(input.dataset.current));
      input.blur();
    }
  });

  container.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    // 参数输入框和确认按钮不触发整行跳转。
    if (target.closest('.param-cell')) {
      const button = target.closest('.confirm-param') as HTMLButtonElement | null;
      if (!button) return;
      const input = button.closest('td')!.querySelector('.param-input') as HTMLInputElement;
      const field = input.dataset.field as ParamField, value = Number(input.value);
      if (!validParam(field, value)) return;
      button.disabled = true; button.textContent = '计算中…';
      void applyParam(input.dataset.id!, field, tick(value));
      return;
    }
    const sortButton = target.closest('[data-sort]') as HTMLButtonElement | null;
    if (sortButton?.dataset.sort) {
      const field = sortButton.dataset.sort as SortField;
      if (sortField === field) sortOrder = sortOrder === 'desc' ? 'asc' : 'desc';
      else { sortField = field; sortOrder = field === 'status' ? 'asc' : 'desc'; }
      render();
      return;
    }
    const button = target.closest('.btn-delete') as HTMLButtonElement | null;
    if (button && button.dataset.id) {
      event.stopPropagation();
      if (confirm('确认删除该回测记录？删除会同步到云端。')) remove([button.dataset.id]);
      return;
    }
    const tr = target.closest('tbody tr') as HTMLTableRowElement | null;
    if (tr && tr.dataset.id) window.location.href = `${detailUrl}?id=${encodeURIComponent(tr.dataset.id)}`;
  });

  syncInput.addEventListener('input', () => localStorage.setItem(SYNC_KEY_STORAGE, syncInput.value.trim()));
  document.querySelector('#copy-sync-key')!.addEventListener('click', async () => {
    await navigator.clipboard.writeText(syncInput.value.trim());
    syncStatus.textContent = '同步密钥已复制。';
  });
  document.querySelector('#sync-records')!.addEventListener('click', () => void syncRecords());
  document.querySelector('#clear')!.addEventListener('click', () => {
    if (confirm('确认清空所有已保存的回测？清空会同步到云端。')) remove(readRecords().map(item => item.id));
  });

  render();
  void refreshMarket();
</script>

<style>
  .compact-hero { margin-bottom: 1.4rem; }
  .actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .btn-back, .btn-clear { border: 1px solid #cbd5e1; border-radius: 7px; padding: 7px 13px; background: #fff; color: #475569; font-size: 13px; font-weight: 500; text-decoration: none; cursor: pointer; transition: all .15s ease; }
  .btn-back:hover { border-color: #94a3b8; color: #0f172a; background: #f8fafc; }
  .btn-clear:hover { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
  .market-status { margin-left: auto; margin-right: 12px; color: #94a3b8; font-size: 12px; }
  .sync-panel { display:flex; flex-wrap:wrap; align-items:center; gap:8px 10px; margin:0 0 16px; padding:12px 14px; border:1px solid #bae6fd; border-radius:10px; background:#f0f9ff; color:#475569; font-size:12px; }.sync-panel > div { margin-right:auto; }.sync-panel strong { color:#0369a1; font-size:13px; }.sync-panel p { margin:2px 0 0; }.sync-panel label { display:flex; align-items:center; gap:6px; white-space:nowrap; }.sync-panel input { width:210px; border:1px solid #bae6fd; border-radius:5px; padding:6px 8px; background:#fff; color:#334155; font:12px ui-monospace,monospace; }.sync-panel button { border:1px solid #bae6fd; border-radius:6px; padding:6px 9px; background:#fff; color:#0369a1; font-size:12px; cursor:pointer; }.sync-panel .sync-primary { border-color:#0369a1; background:#0369a1; color:#fff; }.sync-panel button:disabled { opacity:.6; cursor:wait; }.sync-panel #sync-status { color:#64748b; } @media(max-width:700px){.sync-panel > div{width:100%;margin-right:0}.sync-panel label{width:100%}.sync-panel input{flex:1;min-width:0}}

  .empty { padding: 48px 24px; border: 1px dashed #cbd5e1; border-radius: 14px; background: #fff; text-align: center; }
  .empty-icon { font-size: 38px; margin-bottom: 12px; }
  .empty h3 { margin: 0 0 6px; font-size: 16px; font-weight: 700; color: #1e293b; }
  .empty p { margin: 0 auto 20px; max-width: 420px; font-size: 13px; line-height: 1.6; color: #64748b; }
  .empty .button { display: inline-flex; align-items: center; padding: 8px 18px; border-radius: 7px; background: #0369a1; color: #fff; text-decoration: none; font-size: 13px; font-weight: 600; box-shadow: 0 1px 2px rgb(15 23 42 / .1); transition: background .15s ease; }
  .empty .button:hover { background: #0284c7; }
</style>

<style is:global>
  .table-shell {
    overflow-x: auto;
    overflow-y: hidden;
    min-height: 140px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: white;
    box-shadow: 0 1px 3px rgb(15 23 42 / .04);
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }
  .table-shell::-webkit-scrollbar { height: 6px; width: 6px; }
  .table-shell::-webkit-scrollbar-track { background: transparent; }
  .table-shell::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 3px; }
  .table-shell::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }

  .grid-table { width: max-content; min-width: 100%; border-collapse: collapse; font-size: 12px; }
  .grid-table th { height: 46px; padding: 12px 10px; border-bottom: 1px solid #cbd5e1; background: #f8fafc; color: #475569; font-weight: 600; white-space: nowrap; text-align: center; }
  .grid-table td { height: 50px; padding: 8px 10px; border-bottom: 1px solid #f1f5f9; white-space: nowrap; text-align: center; vertical-align: middle; color: #334155; font-variant-numeric: tabular-nums; }
  .grid-table tbody tr { cursor: pointer; transition: background-color .15s ease; }
  .grid-table tbody tr:hover { background-color: #f1f5f9; }
  .grid-table tr:last-child td { border-bottom: 0; }

  .grid-table .code-cell { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 500; }
  .grid-table .stock-name { min-width: 110px; color: #475569 !important; text-align: center; }
  .grid-table .computed { min-width: 84px; text-align: center; }
  .grid-table .up { color: #dc2626 !important; font-weight: 700; }
  .grid-table .down { color: #16a34a !important; font-weight: 700; }

  .grid-table .row-actions { min-width: 68px; text-align: center; }
  .grid-table .param-cell { min-width: 96px; line-height: 1.35; }
  .grid-table .ratio { display: block; margin-top: 2px; color: #94a3b8; font-size: 11px; }
  .grid-table .param-input { width: 72px; padding: 3px 6px; border: 1px solid transparent; border-radius: 5px; background: transparent; color: inherit; font: inherit; font-variant-numeric: tabular-nums; text-align: center; cursor: text; -moz-appearance: textfield; }
  .grid-table .param-input::-webkit-inner-spin-button, .grid-table .param-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .grid-table .param-input:hover { border-color: #cbd5e1; background: #fff; }
  .grid-table .param-input:focus { outline: none; border-color: #0369a1; background: #fff; box-shadow: 0 0 0 2px rgb(3 105 161 / .15); }
  .grid-table .param-input.dirty { border-color: #fcd34d; background: #fffbeb; color: #b45309; font-weight: 600; }
  .grid-table .confirm-param { margin-top: 3px; border: 1px solid #0369a1; border-radius: 4px; padding: 1px 10px; background: #0369a1; color: #fff; font-size: 11px; line-height: 16px; cursor: pointer; }
  .grid-table .confirm-param:hover { background: #075985; }
  .grid-table .confirm-param:disabled { opacity: .6; cursor: wait; }
  .grid-table .confirm-param[hidden] { display: none; }
  .grid-table .status-cell { min-width: 132px; line-height: 1.35; }
  .grid-table .status-badge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 11px; font-weight: 600; background: #f1f5f9; color: #64748b; }
  .grid-table .status-badge.buy { background: #f0fdf4; color: #16a34a; }
  .grid-table .status-badge.sell { background: #fef2f2; color: #dc2626; }
  .grid-table .status-badge.reached { box-shadow: inset 0 0 0 1px currentColor; }
  .grid-table .status-detail { display: block; margin-top: 3px; color: #475569; font-weight: 600; }
  .grid-table .sort-button { padding: 0; border: 0; background: transparent; color: inherit; font: inherit; font-weight: inherit; cursor: pointer; }
  .grid-table .sort-button:hover { color: #0369a1; }
  .grid-table .btn-delete {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #fecaca;
    border-radius: 5px;
    padding: 3px 9px;
    background: #fef2f2;
    color: #dc2626;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    transition: all .15s ease;
  }
  .grid-table .btn-delete:hover {
    background: #fee2e2;
    border-color: #fca5a5;
  }
</style>
