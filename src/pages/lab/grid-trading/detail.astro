---
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/url';

const savedUrl = href('lab/grid-trading/saved');
---

<Base title="网格回测详情" current="lab" description="网格回测的历史成交明细">
  <header class="hero compact-hero"><p class="kicker">BACKTEST DETAIL</p><h1 id="title">回测详情</h1><p id="subtitle" class="lede">正在读取已保存记录…</p></header>
  <a class="back" href={savedUrl}>← 返回已保存标的</a>
  <section id="stats" class="stats"></section>
  <section class="chart-panel">
    <div class="chart-head"><div><h2>资金与收盘价变化曲线</h2><p>当前标的的历史回测数据；收盘价及预计买卖价使用右侧刻度</p></div><div class="legend"><span class="line position"></span>持仓市值 <span class="line capital"></span>占用本金 <span class="line profit"></span>总盈亏 <span class="line close"></span>收盘价 <span class="line buy-level"></span>预计买入 <span class="line sell-level"></span>预计卖出</div></div>
    <div class="chart-scroll"><svg id="equity-chart" viewBox="0 0 920 300" role="img" aria-label="当前标的的资金与收盘价变化曲线"><text x="460" y="150" text-anchor="middle" fill="#94a3b8" font-size="13">读取已保存回测数据后显示曲线</text></svg></div>
  </section>
  <section class="history"><h2>历史成交</h2><p>成交价格、成交金额、成交份额可直接修改为真实成交值（如按 100 份整数倍成交），修改份额时金额按“份额 × 成交价”计算；修改后该笔及之后的持仓、盈亏、网格价位会重新计算，并自动同步到云端。持仓市值按该笔成交价估值；“当时占用本金”仅统计成交金额，不含手续费，其最高值与回测摘要中的“最多使用本金”一致。最新成交在最上方。</p><p id="sync-note" class="sync-note" role="status" hidden></p><div class="table-shell"><table class="detail-table"><thead><tr><th>日期</th><th>操作</th><th>成交价格</th><th>成交金额</th><th>成交份额</th><th>成交后持仓份额</th><th>成交后持仓市值</th><th>当时占用本金</th><th>当时总盈亏</th></tr></thead><tbody id="trades"></tbody></table></div></section>
</Base>

<script>
  type Candle = { date: string; close: number; high: number; low: number };
  type Trade = { date: string; side: string; price: number; amount: number; shares: number; capitalUsed?: number; pnl: number; quantity?: number; modelPrice?: number; modelAmount?: number; modelQuantity?: number };
  // 按成交日期记录手动修正的真实成交价/成交金额/成交份额；每个交易日最多一笔成交，建仓日即 row.date。
  type PriceOverrides = Record<string, number>;
  type Adjustments = { price?: PriceOverrides; amount?: PriceOverrides; shares?: PriceOverrides };
  type AdjustField = keyof Adjustments;
  type EquityPoint = { date: string; current: number; positionValue: number; capitalUsed: number; pnl: number };
  type RecordItem = {
    id: string;
    savedAt: string;
    updatedAt?: string;
    priceOverrides?: PriceOverrides;
    amountOverrides?: PriceOverrides;
    sharesOverrides?: PriceOverrides;
    refreshedOn?: string;
    realtimeOn?: string;
    row: { name: string; code: string; date: string; initialPrice: number; initialAmount: number; step: number; rebound: number; pullback: number; gridAmount: number };
    result: {
      range: string;
      current: number;
      lastTradeDate?: string;
      lastTrade?: number;
      nextBuy?: number;
      nextSell?: number;
      buyTrigger?: number;
      sellTrigger?: number;
      lowSince?: number;
      highSince?: number;
      pnl: number;
      value: number;
      maxCapital: number;
      buys: number;
      sells: number;
      trades: Trade[];
      series?: EquityPoint[];
    };
  };
  const syncEndpoint = 'https://grid-trading-sync.danielmoore-b0c.workers.dev', syncNoticeKey = 'grid-trading-sync-notice';
  const key = 'grid-trading-saved-v1'; const id = new URLSearchParams(location.search).get('id');
  const money = (v: number) => `${v >= 0 ? '+' : '-'}¥${Math.abs(v).toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const price = (v?: number) => typeof v === 'number' && Number.isFinite(v) ? `¥${v.toFixed(3)}` : '—';
  let record: RecordItem | undefined; try { record = (JSON.parse(localStorage.getItem(key) ?? '[]') as RecordItem[]).find(item => item.id === id); } catch { /* empty */ }
  if (!record) { document.querySelector('#title')!.textContent = '未找到保存记录'; document.querySelector('#subtitle')!.textContent = '该记录可能已被删除，或来自另一台浏览器。'; }
  else {
    document.querySelector('#title')!.textContent = `${record.row.name} · ${record.row.code}`;
    document.querySelector('#subtitle')!.textContent = `${record.result.range} · 初始价 ${record.row.initialPrice} · 每格金额 ¥${record.row.gridAmount.toLocaleString('zh-CN')}`;
    // 先跌破/突破一个步长（触发价），之后反弹/回落设定数值才成交；已达步长时按期间最低/最高点计算成交价。
    const baseTrade = record.result.lastTrade ?? record.row.initialPrice;
    const buyTrigger = record.result.buyTrigger ?? baseTrade - record.row.step;
    const sellTrigger = record.result.sellTrigger ?? baseTrade + record.row.step;
    const { lowSince, highSince } = record.result;
    const buyStepReached = typeof lowSince === 'number';
    const sellStepReached = typeof highSince === 'number';
    // 第一行：目标价及与现价的差距；已达步长时目标价为反弹/回落后的成交价。第二行：反弹/回落金额占现价比例。
    const current = record.result.current;
    const pct = (value: number) => `${value >= 0 ? '+' : ''}${(value * 100).toFixed(2)}%`;
    const gap = (target: number) => `距现价 ${pct((target - current) / current)}`;
    const moveLine = (label: string, value: number) => `${label} ¥${value.toFixed(3)} · 占现价 ${(value / current * 100).toFixed(2)}%`;
    const buyHint = [buyStepReached ? `已跌破，反弹至 ¥${record.result.nextBuy!.toFixed(3)} · ${gap(record.result.nextBuy!)}` : `跌破 ¥${buyTrigger.toFixed(3)} · ${gap(buyTrigger)}`, moveLine('反弹', record.row.rebound)];
    const sellHint = [sellStepReached ? `已突破，回落至 ¥${record.result.nextSell!.toFixed(3)} · ${gap(record.result.nextSell!)}` : `突破 ¥${sellTrigger.toFixed(3)} · ${gap(sellTrigger)}`, moveLine('回落', record.row.pullback)];

    document.querySelector('#stats')!.innerHTML = `
      <div><span>当前价格</span><strong>${price(record.result.current)}</strong></div>
      <div><span>上次成交价</span><strong>${price(record.result.lastTrade)}</strong></div>
      <div>
        <span class="${buyStepReached ? 'warn' : ''}">预计下次买入</span>
        <strong class="down">${price(record.result.nextBuy)}</strong>
        ${buyHint.map(line => `<span class="step-hint">${line}</span>`).join('')}
      </div>
      <div>
        <span class="${sellStepReached ? 'warn' : ''}">预计下次卖出</span>
        <strong class="up">${price(record.result.nextSell)}</strong>
        ${sellHint.map(line => `<span class="step-hint">${line}</span>`).join('')}
      </div>
      <div><span>总盈亏</span><strong class="${record.result.pnl >= 0 ? 'up' : 'down'}">${money(record.result.pnl)}</strong></div>
      <div><span>持仓市值</span><strong>¥${record.result.value.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></div>
      <div><span>最多使用本金</span><strong>¥${record.result.maxCapital.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></div>
      <div><span>买入 / 卖出</span><strong>${record.result.buys} / ${record.result.sells}</strong></div>
    `;
    let derivedCapital = 0;
    const tradeRows = record.result.trades.map((t, index) => {
      // 兼容修复前保存的记录：按成交额和佣金反推当时占用本金。
      if (typeof t.capitalUsed === 'number') derivedCapital = t.capitalUsed;
      else if (index === 0) derivedCapital = t.amount;
      else if (t.side === '买入') derivedCapital += t.amount;
      else derivedCapital -= t.amount;
      const positionValue = t.shares * t.price;
      return `<tr><td>${t.date}</td><td><b class="${t.side === '卖出' ? 'sell' : 'buy'}">${t.side}</b></td><td>${editableCell(t, 'price')}</td><td>${editableCell(t, 'amount')}</td><td>${editableCell(t, 'shares')}</td><td>${t.shares.toLocaleString('zh-CN', { maximumFractionDigits: 2 })}</td><td>¥${positionValue.toLocaleString('zh-CN', { maximumFractionDigits: 2 })}</td><td>¥${derivedCapital.toLocaleString('zh-CN', { maximumFractionDigits: 2 })}</td><td class="${t.pnl >= 0 ? 'up' : 'down'}">${money(t.pnl)}</td></tr>`;
    });
    document.querySelector('#trades')!.innerHTML = tradeRows.reverse().join('');
    bindPriceEditing(record);
    const syncNotice = sessionStorage.getItem(syncNoticeKey);
    if (syncNotice) { sessionStorage.removeItem(syncNoticeKey); const note = document.querySelector('#sync-note') as HTMLElement; note.textContent = syncNotice; note.hidden = false; }
    renderChart(record.result.series ?? [], record.result.nextBuy, record.result.nextSell, record.result.trades);
    void refreshRecord(record);
  }

  function adjustmentsOf(saved: RecordItem): Adjustments {
    return { price: saved.priceOverrides, amount: saved.amountOverrides, shares: saved.sharesOverrides };
  }

  function editableCell(t: Trade, field: AdjustField) {
    const config = {
      price: { digits: 3, step: '0.001', label: '成交价格', value: t.price, model: t.modelPrice },
      amount: { digits: 2, step: '0.01', label: '成交金额', value: t.amount, model: t.modelAmount },
      // 旧记录没有 quantity，按成交金额 ÷ 成交价反推。
      shares: { digits: 2, step: '100', label: '成交份额', value: t.quantity ?? t.amount / t.price, model: t.modelQuantity },
    }[field];
    const adjusted = typeof config.model === 'number';
    const shown = field === 'shares' ? String(Number(config.value.toFixed(2))) : config.value.toFixed(config.digits);
    return `<span class="price-edit"><input class="price-input${field === 'price' ? '' : ' amount-input'}${adjusted ? ' adjusted' : ''}" type="number" inputmode="decimal" step="${config.step}" min="0.001" value="${shown}" data-date="${t.date}" data-field="${field}" data-digits="${config.digits}" data-original="${Number(shown).toFixed(config.digits)}" aria-label="${t.date} ${config.label}"><button type="button" class="confirm-edit" hidden>确认</button></span>`;
  }

  function bindPriceEditing(saved: RecordItem) {
    const table = document.querySelector('#trades') as HTMLElement;
    const commit = (field: AdjustField, date: string, value: number) => {
      const adjustments = adjustmentsOf(saved);
      const next: Adjustments = { price: { ...adjustments.price }, amount: { ...adjustments.amount }, shares: { ...adjustments.shares } };
      // 金额与份额互相决定，同一笔只保留最后修改的那一项。
      if (field !== 'price') { delete next.amount![date]; delete next.shares![date]; }
      else delete next.price![date];
      next[field]![date] = value;
      void applyOverrides(saved, next);
    };
    const inputOf = (target: EventTarget | null) => (target as HTMLElement).closest('.price-input') as HTMLInputElement | null;
    // 输入值与原值不同时显示确认按钮，确认后才保存并重算。
    table.addEventListener('input', event => {
      const input = inputOf(event.target);
      if (!input) return;
      const value = Number(input.value), digits = Number(input.dataset.digits);
      (input.nextElementSibling as HTMLButtonElement).hidden = !(Number.isFinite(value) && value > 0 && value.toFixed(digits) !== input.dataset.original);
    });
    table.addEventListener('keydown', event => {
      const input = inputOf(event.target), key = (event as KeyboardEvent).key;
      if (!input) return;
      const button = input.nextElementSibling as HTMLButtonElement;
      if (key === 'Enter' && !button.hidden) button.click();
      if (key === 'Escape') { input.value = input.dataset.original!; button.hidden = true; input.blur(); }
    });
    table.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest('.confirm-edit') as HTMLButtonElement | null;
      if (!button) return;
      const input = button.previousElementSibling as HTMLInputElement;
      const value = Number(input.value), digits = Number(input.dataset.digits);
      if (!Number.isFinite(value) || value <= 0) return;
      button.disabled = true; button.textContent = '计算中…';
      commit(input.dataset.field as AdjustField, input.dataset.date!, Number(value.toFixed(digits)));
    });
  }

  async function applyOverrides(saved: RecordItem, adjustments: Adjustments) {
    document.querySelector('#subtitle')!.textContent = '正在按修正后的成交数据重新计算…';
    const cacheKey = `grid-trading-market-cache-v1:${saved.row.code}:${saved.row.date}`;
    let cached: { date: string; candles: Candle[] } | undefined;
    try { cached = JSON.parse(localStorage.getItem(cacheKey) ?? ''); } catch { /* miss */ }
    const now = new Date().toISOString();
    let updated: RecordItem = { ...saved, priceOverrides: adjustments.price, amountOverrides: adjustments.amount, sharesOverrides: adjustments.shares, updatedAt: now };
    if (cached?.candles?.length) {
      const candles = await mergeRealtimeCandle(saved.row.code, cached.candles);
      updated = { ...updated, result: calculateFromCandles(saved.row, candles, adjustments) };
    } else {
      // 本机没有日线缓存（例如记录来自云端同步），清除刷新标记，重载时重新拉取行情并按修正值重算。
      updated = { ...updated, refreshedOn: undefined };
    }
    try {
      const records = JSON.parse(localStorage.getItem(key) ?? '[]') as RecordItem[];
      localStorage.setItem(key, JSON.stringify(records.map(item => item.id === saved.id ? updated : item)));
    } catch {
      document.querySelector('#subtitle')!.textContent = '保存修正值失败，请稍后重试';
      return;
    }
    document.querySelector('#subtitle')!.textContent = '正在同步到云端…';
    const notice = await pushToCloud(updated);
    if (notice) sessionStorage.setItem(syncNoticeKey, notice);
    location.reload();
  }

  // 仅把本条记录合并进云端（云端版本更新时不覆盖），不改动本机的其它记录；返回需要提示的失败信息。
  async function pushToCloud(item: RecordItem) {
    const token = localStorage.getItem('grid-trading-sync-key-v1')?.trim() ?? '';
    if (token.length < 16) return '修正已保存到本机；尚未设置同步密钥，未同步到云端。';
    const stamp = (record: RecordItem) => new Date(record.updatedAt ?? record.savedAt).valueOf();
    try {
      const headers = { authorization: `Bearer ${token}`, 'content-type': 'application/json' };
      const response = await fetch(syncEndpoint, { headers, signal: AbortSignal.timeout(8000) });
      if (!response.ok) throw new Error('读取云端记录失败');
      const remote = ((await response.json()).records ?? []) as RecordItem[];
      const existing = remote.find(record => record.id === item.id);
      if (existing && stamp(existing) > stamp(item)) return '云端有更新的版本，本次修正未上传，请到“已保存标的”页手动同步。';
      const records = existing ? remote.map(record => record.id === item.id ? item : record) : [item, ...remote];
      const put = await fetch(syncEndpoint, { method: 'PUT', headers, body: JSON.stringify({ records }), signal: AbortSignal.timeout(8000) });
      if (!put.ok) throw new Error('写入云端记录失败');
      return '';
    } catch {
      return '修正已保存到本机，但同步云端失败，请稍后在“已保存标的”页手动同步。';
    }
  }

  async function refreshRecord(saved: RecordItem) {
    const today = new Date().toISOString().slice(0, 10);
    const cacheKey = `grid-trading-market-cache-v1:${saved.row.code}:${saved.row.date}`;
    type CacheItem = { date: string; candles: Candle[] };
    let cached: CacheItem | undefined;
    try { cached = JSON.parse(localStorage.getItem(cacheKey) ?? ''); } catch { /* miss */ }
    // 历史日线每天只需拉取一次；实时价仍可在当日补充一次。
    // 本机没有日线缓存时（如记录来自云端同步）即使今天已刷新过也要重新拉取，否则只能沿用旧结果。
    if (saved.refreshedOn === today && cached?.candles?.length) {
      // 用本页会话标记避免刷新后循环重载；新开页面仍会重新取得当日高低价。
      // 版本号变更时重算已保存记录，避免浏览器会话沿用旧的计算逻辑。
      const refreshMark = `grid-trading-realtime-refresh-v5:${saved.id}:${today}`;
      if (!sessionStorage.getItem(refreshMark)) {
        sessionStorage.setItem(refreshMark, '1');
        await refreshRealtimeSnapshot(saved, today);
      }
      return;
    }
    let candles = cached?.date === today ? cached.candles : undefined;
    document.querySelector('#subtitle')!.textContent = '正在刷新行情并重新计算…';
    try {
      if (!candles?.length) {
        const symbol = /^[569]/.test(saved.row.code) ? `sh${saved.row.code}` : `sz${saved.row.code}`;
        let end = today, lines: string[][] = [];
        for (let page = 0; page < 20; page++) {
          const response = await fetch(`https://web.ifzq.gtimg.cn/appstock/app/fqkline/get?param=${symbol},day,${saved.row.date},${end},640,qfq`);
          if (!response.ok) throw new Error('行情服务暂不可用');
          const payload = await response.json();
          // 部分 ETF 的前复权接口以 day 返回日线，股票通常为 qfqday。
          const batch: string[][] = payload.data?.[symbol]?.qfqday ?? payload.data?.[symbol]?.day ?? [];
          if (!batch.length) break;
          lines = [...batch, ...lines];
          const firstDate = batch[0][0];
          if (firstDate <= saved.row.date || batch.length < 640) break;
          const previous = new Date(`${firstDate}T00:00:00Z`); previous.setUTCDate(previous.getUTCDate() - 1); end = previous.toISOString().slice(0, 10);
        }
        candles = [...new Map(lines.map(line => [line[0], line])).values()]
          .map(line => ({ date: line[0], close: Number(line[2]), high: Number(line[3]), low: Number(line[4]) }))
          .filter(candle => candle.date >= saved.row.date)
          .sort((a, b) => a.date.localeCompare(b.date));
        localStorage.setItem(cacheKey, JSON.stringify({ date: today, candles }));
      }
      if (!candles.length) throw new Error('没有可用日线');
      candles = await mergeRealtimeCandle(saved.row.code, candles);
      const result = calculateFromCandles(saved.row, candles, adjustmentsOf(saved));
      const updated = { ...saved, refreshedOn: today, realtimeOn: today, result };
      const records = JSON.parse(localStorage.getItem(key) ?? '[]') as RecordItem[];
      localStorage.setItem(key, JSON.stringify(records.map(item => item.id === saved.id ? updated : item)));
      location.reload();
    } catch {
      document.querySelector('#subtitle')!.textContent = `${saved.result.range} · 行情刷新失败，当前显示已保存快照`;
    }
  }

  async function refreshRealtimeSnapshot(saved: RecordItem, today: string) {
    const cacheKey = `grid-trading-market-cache-v1:${saved.row.code}:${saved.row.date}`;
    type CacheItem = { date: string; candles: Candle[] };
    let cached: CacheItem | undefined;
    try { cached = JSON.parse(localStorage.getItem(cacheKey) ?? ''); } catch { /* miss */ }
    const candles = cached?.candles?.length ? await mergeRealtimeCandle(saved.row.code, cached.candles) : [];
    const result = candles.length ? calculateFromCandles(saved.row, candles, adjustmentsOf(saved)) : saved.result;
    const updated = { ...saved, realtimeOn: today, result };
    try {
      const records = JSON.parse(localStorage.getItem(key) ?? '[]') as RecordItem[];
      localStorage.setItem(key, JSON.stringify(records.map(item => item.id === saved.id ? updated : item)));
      location.reload();
    } catch { /* 保留原快照 */ }
  }

  async function mergeRealtimeCandle(code: string, candles: Candle[]) {
    try {
      const symbol = /^[569]/.test(code) ? `sh${code}` : `sz${code}`;
      const response = await fetch(`https://qt.gtimg.cn/q=${symbol}`);
      const text = new TextDecoder('gbk').decode(await response.arrayBuffer());
      const fields = text.match(/="([\s\S]*)"/)?.[1]?.split('~') ?? [];
      const close = Number(fields[3]), high = Number(fields[33]), low = Number(fields[34]);
      const stamp = fields[30] ?? '';
      if (!Number.isFinite(close) || !Number.isFinite(high) || !Number.isFinite(low) || stamp.length < 8) return candles;
      const date = `${stamp.slice(0, 4)}-${stamp.slice(4, 6)}-${stamp.slice(6, 8)}`;
      const existing = candles.findIndex(candle => candle.date === date);
      const live: Candle = { date, close, high, low };
      if (existing >= 0) {
        const previous = candles[existing];
        const merged = [...candles];
        merged[existing] = { date, close, high: Math.max(previous.high, high), low: Math.min(previous.low, low) };
        return merged;
      }
      if (!candles.length || date > candles.at(-1)!.date) return [...candles, live];
      return candles;
    } catch { return candles; }
  }

  function calculateFromCandles(row: RecordItem['row'], candles: Candle[], adjustments: Adjustments = {}): RecordItem['result'] {
    const feeRate = .00015, taxRate = /^(5\d{5}|1[5-8]\d{4})$/.test(row.code) ? 0 : .0005;
    // 有修正值时按真实成交价/成交金额成交，成交价同时作为后续网格的基准价；model* 记录原计算值，用于标记已修正的单元格。
    const pick = (map: PriceOverrides | undefined, date: string) => {
      const value = map?.[date];
      return typeof value === 'number' && Number.isFinite(value) && value > 0 ? value : undefined;
    };
    const fillPrice = (date: string, modelPrice: number) => {
      const value = pick(adjustments.price, date);
      return value === undefined ? { price: modelPrice } : { price: value, modelPrice };
    };
    // 份额修正优先：金额 = 份额 × 成交价；否则按修正金额反推份额。
    const fillAmount = (date: string, modelAmount: number, price: number) => {
      const quantity = pick(adjustments.shares, date);
      if (quantity !== undefined) return { amount: quantity * price, quantity, modelAmount, modelQuantity: modelAmount / price };
      const amount = pick(adjustments.amount, date);
      return amount === undefined ? { amount: modelAmount, quantity: modelAmount / price } : { amount, quantity: amount / price, modelAmount };
    };
    const opening = fillPrice(row.date, row.initialPrice), openingFill = fillAmount(row.date, row.initialAmount, opening.price), openingAmount = openingFill.amount;
    let cash = -openingAmount * feeRate, shares = openingFill.quantity, cost = openingAmount * (1 + feeRate), capitalUsed = openingAmount, maxCapital = capitalUsed, lastTrade = opening.price, lastTradeDate = row.date, realized = 0, buys = 0, sells = 0;
    let lowSince: number | null = null, highSince: number | null = null;
    // 建仓当笔总盈亏按建仓日（首个交易日）收盘价结算持仓市值。
    const openingCandle = candles.find(candle => candle.date >= row.date), openingDay = openingCandle?.date;
    const trades: Trade[] = [{ date: row.date, side: '建仓', ...opening, ...openingFill, shares, capitalUsed, pnl: cash + shares * (openingCandle?.close ?? opening.price) - openingAmount }];
    const series: EquityPoint[] = [];
    for (const candle of candles) {
      if (candle.date !== openingDay) {
        // 先跌破/突破上次成交价一个步长，记录此后的最低/最高点，再反弹/回落设定数值才成交。
        // 日线无法区分同日高低价先后，达到步长的当天不确认反转，从之后的交易日开始判断。
        let traded = false;
        if (lowSince !== null && candle.high >= lowSince + row.rebound) {
          const buyPrice = lowSince + row.rebound; traded = true;
          const fill = fillPrice(candle.date, buyPrice), tradePrice = fill.price, amountFill = fillAmount(candle.date, row.gridAmount, tradePrice), amount = amountFill.amount, quantity = amountFill.quantity, fee = amount * feeRate;
          shares += quantity; cost += amount + fee; cash -= amount + fee; capitalUsed += amount; maxCapital = Math.max(maxCapital, capitalUsed); lastTrade = tradePrice; lastTradeDate = candle.date; buys++;
          trades.push({ date: candle.date, side: '买入', ...fill, ...amountFill, shares, capitalUsed, pnl: cash + shares * tradePrice - openingAmount });
        } else if (highSince !== null && candle.low <= highSince - row.pullback) {
          const sellPrice = highSince - row.pullback; traded = true;
          const fill = fillPrice(candle.date, sellPrice), tradePrice = fill.price, modelProceeds = Math.min(shares, row.gridAmount / tradePrice) * tradePrice;
          // 修正后的卖出份额不能超过当前全部持仓。
          const amountFill = fillAmount(candle.date, modelProceeds, tradePrice), quantity = Math.min(shares, amountFill.quantity);
          if (quantity > 0) { const proceeds = quantity * tradePrice, fee = proceeds * feeRate, netProceeds = proceeds - fee - proceeds * taxRate, unitCost = cost / shares; shares -= quantity; cash += netProceeds; capitalUsed -= proceeds; realized += netProceeds - quantity * unitCost; cost -= quantity * unitCost; lastTrade = tradePrice; lastTradeDate = candle.date; sells++; trades.push({ date: candle.date, side: '卖出', ...fill, ...amountFill, amount: proceeds, quantity, shares, capitalUsed, pnl: cash + shares * tradePrice - openingAmount }); }
        }
        if (traded) { lowSince = null; highSince = null; }
        else {
          if (candle.low <= lastTrade - row.step) lowSince = Math.min(lowSince ?? candle.low, candle.low);
          if (candle.high >= lastTrade + row.step) highSince = Math.max(highSince ?? candle.high, candle.high);
        }
      }
      series.push({ date: candle.date, current: candle.close, positionValue: shares * candle.close, capitalUsed, pnl: cash + shares * candle.close - openingAmount });
    }
    const current = candles.at(-1)!.close, value = cash + shares * current;
    const buyTrigger = lastTrade - row.step, sellTrigger = lastTrade + row.step;
    const nextBuy = (lowSince ?? buyTrigger) + row.rebound, nextSell = (highSince ?? sellTrigger) - row.pullback;
    return { range: `${candles[0].date} ～ ${candles.at(-1)!.date}`, current, lastTradeDate, lastTrade, nextBuy, nextSell, buyTrigger, sellTrigger, lowSince: lowSince ?? undefined, highSince: highSince ?? undefined, pnl: value - openingAmount, value, maxCapital, buys, sells, trades, series };
  }

  function renderChart(series: EquityPoint[], nextBuy?: number, nextSell?: number, trades: Trade[] = []) {
    const svg = document.querySelector('#equity-chart') as SVGSVGElement;
    if (!series.length || !Number.isFinite(nextBuy) || !Number.isFinite(nextSell)) { svg.innerHTML = '<text x="460" y="150" text-anchor="middle" fill="#94a3b8" font-size="13">此保存记录没有完整曲线数据</text>'; return; }
    const buyLevel = nextBuy!, sellLevel = nextSell!;
    const format = (v: number) => v.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const width = 920, height = 300, left = 62, right = 54, top = 18, bottom = 38, chartWidth = width - left - right, chartHeight = height - top - bottom;
    const values = series.flatMap(point => [point.positionValue, point.capitalUsed, point.pnl]);
    const min = Math.min(0, ...values), max = Math.max(...values), span = max - min || 1, yMin = min - span * .06, yMax = max + span * .06;
    const priceMinRaw = Math.min(...series.map(point => point.current), buyLevel), priceMaxRaw = Math.max(...series.map(point => point.current), sellLevel), priceSpan = priceMaxRaw - priceMinRaw || Math.max(priceMaxRaw * .02, .01), priceMin = priceMinRaw - priceSpan * .06, priceMax = priceMaxRaw + priceSpan * .06;
    const x = (index: number) => left + index / Math.max(1, series.length - 1) * chartWidth;
    const y = (value: number) => top + (yMax - value) / (yMax - yMin) * chartHeight;
    const priceY = (value: number) => top + (priceMax - value) / (priceMax - priceMin) * chartHeight;
    const path = (field: 'positionValue' | 'pnl') => series.map((point, index) => `${index ? 'L' : 'M'}${x(index).toFixed(1)},${y(point[field]).toFixed(1)}`).join('');
    // 占用本金只在成交日跳变：先沿上一日数值水平延伸，到成交日再竖直跳到新值（阶梯线）。
    const capitalPath = series.map((point, index) => index ? `H${x(index).toFixed(1)}V${y(point.capitalUsed).toFixed(1)}` : `M${x(0).toFixed(1)},${y(point.capitalUsed).toFixed(1)}`).join('');
    const grid = Array.from({ length: 5 }, (_, index) => { const value = yMin + (yMax - yMin) * index / 4, yy = y(value); return `<line x1="${left}" x2="${width - right}" y1="${yy}" y2="${yy}" stroke="#e2e8f0"/><text x="${left - 8}" y="${yy + 4}" text-anchor="end" fill="#94a3b8" font-size="10">${(value / 10000).toFixed(1)}万</text>`; }).join('');
    const priceLabels = Array.from({ length: 5 }, (_, index) => { const value = priceMin + (priceMax - priceMin) * index / 4, yy = priceY(value); return `<text x="${width - right + 8}" y="${yy + 4}" fill="#64748b" font-size="10">${value.toFixed(3)}</text>`; }).join('');
    const labels = [0, Math.floor((series.length - 1) / 2), series.length - 1].map(index => `<text x="${x(index)}" y="${height - 12}" text-anchor="middle" fill="#94a3b8" font-size="10">${series[index].date}</text>`).join('');
    const zero = min < 0 ? `<line x1="${left}" x2="${width - right}" y1="${y(0)}" y2="${y(0)}" stroke="#475569" stroke-width="1.5" stroke-dasharray="6 4"/>` : '';
    const levels = `<line x1="${left}" x2="${width - right}" y1="${priceY(buyLevel)}" y2="${priceY(buyLevel)}" stroke="#16a34a" stroke-width="1.5" stroke-dasharray="5 4"/><text x="${width - right + 8}" y="${priceY(buyLevel) + 4}" fill="#16a34a" font-size="10">买 ${buyLevel.toFixed(3)}</text><line x1="${left}" x2="${width - right}" y1="${priceY(sellLevel)}" y2="${priceY(sellLevel)}" stroke="#ea580c" stroke-width="1.5" stroke-dasharray="5 4"/><text x="${width - right + 8}" y="${priceY(sellLevel) + 4}" fill="#ea580c" font-size="10">卖 ${sellLevel.toFixed(3)}</text>`;
    const tooltipLines = ['date', 'trade', 'current', 'position', 'capital', 'profit'];
    svg.innerHTML = `<g>${grid}${zero}${priceLabels}${levels}</g><path d="${path('positionValue')}" fill="none" stroke="#2563eb" stroke-width="1.5"/><path d="${capitalPath}" fill="none" stroke="#f59e0b" stroke-width="1.5"/><path d="${path('pnl')}" fill="none" stroke="#dc2626" stroke-width="1.5"/><path d="${series.map((point, index) => `${index ? 'L' : 'M'}${x(index).toFixed(1)},${priceY(point.current).toFixed(1)}`).join('')}" fill="none" stroke="#7c3aed" stroke-width="1.5"/>${labels}`
      + `<g class="chart-crosshair" visibility="hidden" pointer-events="none"><line class="crosshair-v" y1="${top}" y2="${height - bottom}" stroke="#64748b" stroke-width="1" stroke-dasharray="3 3"/><line class="crosshair-h" x1="${left}" x2="${width - right}" stroke="#64748b" stroke-width="1" stroke-dasharray="3 3"/>`
      + `<circle class="dot-position" r="4" fill="#2563eb" stroke="#fff" stroke-width="2"/><circle class="dot-capital" r="4" fill="#f59e0b" stroke="#fff" stroke-width="2"/><circle class="dot-profit" r="4" fill="#dc2626" stroke="#fff" stroke-width="2"/><circle class="dot-current" r="4" fill="#7c3aed" stroke="#fff" stroke-width="2"/>`
      + `<g class="chart-tooltip"><rect fill="#0f172a" fill-opacity=".94" rx="6"/>${tooltipLines.map((name, index) => `<text class="tip-${name}" x="10" y="${17 + index * 18}" fill="#f8fafc" font-size="10"${index ? '' : ' font-weight="700"'}/>`).join('')}</g></g>`
      + `<rect class="chart-hit-area" x="${left}" y="${top}" width="${chartWidth}" height="${chartHeight}" fill="transparent" style="cursor:crosshair"/>`;
    const crosshair = svg.querySelector('.chart-crosshair') as SVGGElement, tooltip = svg.querySelector('.chart-tooltip') as SVGGElement;
    const set = (selector: string, attrs: Record<string, number | string>) => { const el = svg.querySelector(selector)!; for (const [name, value] of Object.entries(attrs)) el.setAttribute(name, String(value)); };
    const setText = (name: string, text: string) => { tooltip.querySelector(`.tip-${name}`)!.textContent = text; };
    const tradeByDate = new Map(trades.map(t => [t.date, t]));
    const showPoint = (event: PointerEvent) => {
      const bounds = svg.getBoundingClientRect();
      const pointerX = (event.clientX - bounds.left) * width / bounds.width, pointerY = (event.clientY - bounds.top) * height / bounds.height;
      const index = Math.max(0, Math.min(series.length - 1, Math.round((pointerX - left) / chartWidth * (series.length - 1))));
      const point = series[index], xx = x(index), trade = tradeByDate.get(point.date);
      set('.crosshair-v', { x1: xx, x2: xx });
      set('.crosshair-h', { y1: pointerY, y2: pointerY });
      set('.dot-position', { cx: xx, cy: y(point.positionValue) });
      set('.dot-capital', { cx: xx, cy: y(point.capitalUsed) });
      set('.dot-profit', { cx: xx, cy: y(point.pnl) });
      set('.dot-current', { cx: xx, cy: priceY(point.current) });
      setText('date', point.date);
      setText('trade', trade ? `成交  ${trade.side} ${trade.price.toFixed(3)} · ¥${format(trade.amount)}` : '成交  —');
      setText('current', `收盘价  ${point.current.toFixed(3)}`);
      setText('position', `持仓市值  ¥${format(point.positionValue)}`);
      setText('capital', `占用本金  ¥${format(point.capitalUsed)}`);
      setText('profit', `总盈亏  ${money(point.pnl)}`);
      const tooltipWidth = 200, tooltipHeight = 18 * tooltipLines.length + 8;
      const tooltipX = xx > width - right - tooltipWidth - 12 ? xx - tooltipWidth - 12 : xx + 12;
      const tooltipY = Math.max(top, Math.min(height - bottom - tooltipHeight, pointerY - tooltipHeight / 2));
      tooltip.setAttribute('transform', `translate(${tooltipX},${tooltipY})`);
      set('.chart-tooltip rect', { width: tooltipWidth, height: tooltipHeight });
      crosshair.setAttribute('visibility', 'visible');
    };
    const hitArea = svg.querySelector('.chart-hit-area')!;
    hitArea.addEventListener('pointermove', event => showPoint(event as PointerEvent));
    hitArea.addEventListener('pointerleave', () => crosshair.setAttribute('visibility', 'hidden'));
  }
</script>

