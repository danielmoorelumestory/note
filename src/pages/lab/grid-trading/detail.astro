---
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/url';

const savedUrl = href('lab/grid-trading/saved');
---

<Base title="网格回测详情" current="lab" description="网格回测的历史成交明细">
  <header class="hero compact-hero"><p class="kicker">BACKTEST DETAIL</p><h1 id="title">回测详情</h1><p id="subtitle" class="lede">正在读取已保存记录…</p></header>
  <a class="back" href={savedUrl}>← 返回已保存标的</a>
  <section id="stats" class="stats"></section>
  <section class="chart-panel">
    <div class="chart-head"><div><h2>资金与收盘价变化曲线</h2><p>当前标的的历史回测数据；收盘价及预计买卖价使用右侧刻度</p></div><div class="legend"><span class="line position"></span>持仓市值 <span class="line capital"></span>占用本金 <span class="line profit"></span>总盈亏 <span class="line close"></span>收盘价 <span class="line buy-level"></span>预计买入 <span class="line sell-level"></span>预计卖出</div></div>
    <div class="chart-scroll"><svg id="equity-chart" viewBox="0 0 920 300" role="img" aria-label="当前标的的资金与收盘价变化曲线"><text x="460" y="150" text-anchor="middle" fill="#94a3b8" font-size="13">读取已保存回测数据后显示曲线</text></svg></div>
  </section>
  <section class="history"><h2>历史成交</h2><p>成交价格、成交金额、成交份额可直接修改为真实成交值（如按 100 份整数倍成交），修改份额时金额按“份额 × 成交价”计算；修改后该笔及之后的持仓、盈亏、网格价位会重新计算，并自动同步到云端。持仓市值按该笔成交价估值；“当时占用本金”仅统计成交金额，不含手续费，其最高值与回测摘要中的“最多使用本金”一致。最新成交在最上方。</p><p id="sync-note" class="sync-note" role="status" hidden></p><div class="table-shell"><table class="detail-table"><thead><tr><th>日期</th><th>操作</th><th>成交价格</th><th>成交金额</th><th>成交份额</th><th>成交后持仓份额</th><th>成交后持仓市值</th><th>当时占用本金</th><th>当时总盈亏</th></tr></thead><tbody id="trades"></tbody></table></div></section>
</Base>

<script>
  import {
    calculateGrid, adjustmentsOf, getCandles, fetchQuotes, mergeQuote, refreshRecord, readRecords, saveRecord, pushRecord,
    renderEquityChart, formatMoney, formatAmount, formatPercent,
    type SavedRecord, type Trade, type Adjustments,
  } from '../../../lib/grid-trading';

  type AdjustField = 'price' | 'amount' | 'shares';
  const id = new URLSearchParams(location.search).get('id');
  const subtitle = document.querySelector('#subtitle') as HTMLElement;
  const price = (v?: number) => typeof v === 'number' && Number.isFinite(v) ? `¥${v.toFixed(3)}` : '—';
  let record = readRecords().find(item => item.id === id);

  function showNote(text: string) {
    const note = document.querySelector('#sync-note') as HTMLElement;
    note.textContent = text; note.hidden = !text;
  }

  function render(item: SavedRecord) {
    const { row, result } = item;
    document.querySelector('#title')!.textContent = `${row.name} · ${row.code}`;
    subtitle.textContent = `${result.range} · 初始价 ${row.initialPrice} · 每格金额 ¥${row.gridAmount.toLocaleString('zh-CN')}`;
    // 预计买卖价是固定成交价，日内高低价触及即执行。
    const current = result.current;
    const buyReached = current <= result.nextBuy, sellReached = current >= result.nextSell;
    const gap = (target: number) => `距现价 ${formatPercent((target - current) / current)}`;
    const moveLine = (label: string, value: number) => `${label} ¥${value.toFixed(3)} · 占现价 ${(value / current * 100).toFixed(2)}%`;
    const buyHint = [buyReached ? `已达到买入价 ¥${result.nextBuy.toFixed(3)}` : `价格达到 ¥${result.nextBuy.toFixed(3)} 即买入 · ${gap(result.nextBuy)}`, moveLine('反弹', row.rebound)];
    const sellHint = [sellReached ? `已达到卖出价 ¥${result.nextSell.toFixed(3)}` : `价格达到 ¥${result.nextSell.toFixed(3)} 即卖出 · ${gap(result.nextSell)}`, moveLine('回落', row.pullback)];
    const hint = (lines: string[]) => lines.map(line => `<span class="step-hint">${line}</span>`).join('');
    document.querySelector('#stats')!.innerHTML = `
      <div><span>当前价格</span><strong>${price(current)}</strong></div>
      <div><span>上次成交价</span><strong>${price(result.lastTrade)}</strong></div>
      <div><span class="${buyReached ? 'warn' : ''}">预计下次买入</span><strong class="down">${price(result.nextBuy)}</strong>${hint(buyHint)}</div>
      <div><span class="${sellReached ? 'warn' : ''}">预计下次卖出</span><strong class="up">${price(result.nextSell)}</strong>${hint(sellHint)}</div>
      <div><span>总盈亏</span><strong class="${result.pnl >= 0 ? 'up' : 'down'}">${formatMoney(result.pnl)}</strong></div>
      <div><span>持仓市值</span><strong>¥${formatAmount(result.value)}</strong></div>
      <div><span>最多使用本金</span><strong>¥${formatAmount(result.maxCapital)}</strong></div>
      <div><span>买入 / 卖出</span><strong>${result.buys} / ${result.sells}</strong></div>
    `;
    let derivedCapital = 0;
    const rows = result.trades.map((t, index) => {
      // 兼容早期保存的记录：没有 capitalUsed 时按成交额反推当时占用本金。
      if (typeof t.capitalUsed === 'number') derivedCapital = t.capitalUsed;
      else if (index === 0) derivedCapital = t.amount;
      else derivedCapital += t.side === '买入' ? t.amount : -t.amount;
      const number2 = (v: number) => v.toLocaleString('zh-CN', { maximumFractionDigits: 2 });
      return `<tr><td>${t.date}</td><td><b class="${t.side === '卖出' ? 'sell' : 'buy'}">${t.side}</b></td><td>${editableCell(t, 'price')}</td><td>${editableCell(t, 'amount')}</td><td>${editableCell(t, 'shares')}</td><td>${number2(t.shares)}</td><td>¥${number2(t.shares * t.price)}</td><td>¥${number2(derivedCapital)}</td><td class="${t.pnl >= 0 ? 'up' : 'down'}">${formatMoney(t.pnl)}</td></tr>`;
    });
    document.querySelector('#trades')!.innerHTML = rows.reverse().join('');
    renderEquityChart(document.querySelector('#equity-chart') as SVGSVGElement, result.series ?? [], result.nextBuy, result.nextSell, result.trades);
  }

  function editableCell(t: Trade, field: AdjustField) {
    const config = {
      price: { digits: 3, step: '0.001', label: '成交价格', value: t.price, model: t.modelPrice },
      amount: { digits: 2, step: '0.01', label: '成交金额', value: t.amount, model: t.modelAmount },
      // 旧记录没有 quantity，按成交金额 ÷ 成交价反推。
      shares: { digits: 2, step: '100', label: '成交份额', value: t.quantity ?? t.amount / t.price, model: t.modelQuantity },
    }[field];
    const adjusted = typeof config.model === 'number';
    const shown = field === 'shares' ? String(Number(config.value.toFixed(2))) : config.value.toFixed(config.digits);
    return `<span class="price-edit"><input class="price-input${field === 'price' ? '' : ' amount-input'}${adjusted ? ' adjusted' : ''}" type="number" inputmode="decimal" step="${config.step}" min="0.001" value="${shown}" data-date="${t.date}" data-field="${field}" data-digits="${config.digits}" data-original="${Number(shown).toFixed(config.digits)}" aria-label="${t.date} ${config.label}"><button type="button" class="confirm-edit" hidden>确认</button></span>`;
  }

  // 修正成交值：用缓存日线立即重算并保存，再把该条记录推送到云端；全程原地刷新，不重载页面。
  async function applyAdjustment(field: AdjustField, date: string, value: number) {
    if (!record) return;
    const current = adjustmentsOf(record);
    const next: Adjustments = { ...current, price: { ...current.price }, amount: { ...current.amount }, shares: { ...current.shares } };
    // 金额与份额互相决定，同一笔只保留最后修改的那一项。
    if (field !== 'price') { delete next.amount![date]; delete next.shares![date]; }
    else delete next.price![date];
    next[field]![date] = value;
    subtitle.textContent = '正在按修正后的成交数据重新计算…';
    try {
      const candles = mergeQuote(await getCandles(record.row.code, record.row.date), (await fetchQuotes([record.row.code])).get(record.row.code));
      if (!candles.length) throw new Error('没有可用日线');
      record = { ...record, priceOverrides: next.price, amountOverrides: next.amount, sharesOverrides: next.shares, updatedAt: new Date().toISOString(), result: calculateGrid(record.row, candles, next) };
      saveRecord(record);
      render(record);
    } catch {
      subtitle.textContent = '行情获取失败，修正未保存，请稍后重试';
      render(record);
      return;
    }
    showNote('正在同步到云端…');
    showNote(await pushRecord(record));
  }

  function bindEditing() {
    const table = document.querySelector('#trades') as HTMLElement;
    const inputOf = (target: EventTarget | null) => (target as HTMLElement).closest('.price-input') as HTMLInputElement | null;
    // 输入值与原值不同时显示确认按钮，确认后才保存并重算。
    table.addEventListener('input', event => {
      const input = inputOf(event.target);
      if (!input) return;
      const value = Number(input.value), digits = Number(input.dataset.digits);
      (input.nextElementSibling as HTMLButtonElement).hidden = !(Number.isFinite(value) && value > 0 && value.toFixed(digits) !== input.dataset.original);
    });
    table.addEventListener('keydown', event => {
      const input = inputOf(event.target), key = (event as KeyboardEvent).key;
      if (!input) return;
      const button = input.nextElementSibling as HTMLButtonElement;
      if (key === 'Enter' && !button.hidden) button.click();
      if (key === 'Escape') { input.value = input.dataset.original!; button.hidden = true; input.blur(); }
    });
    table.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest('.confirm-edit') as HTMLButtonElement | null;
      if (!button) return;
      const input = button.previousElementSibling as HTMLInputElement;
      const value = Number(input.value), digits = Number(input.dataset.digits);
      if (!Number.isFinite(value) || value <= 0) return;
      button.disabled = true; button.textContent = '计算中…';
      void applyAdjustment(input.dataset.field as AdjustField, input.dataset.date!, Number(value.toFixed(digits)));
    });
  }

  if (!record) {
    document.querySelector('#title')!.textContent = '未找到保存记录';
    subtitle.textContent = '该记录可能已被删除，或来自另一台浏览器。';
  } else {
    render(record);
    bindEditing();
    // 先显示已保存快照，再用最新行情（日线按天缓存、报价 60 秒缓存）重算并原地更新。
    const snapshot = record;
    refreshRecord(snapshot).then(updated => {
      if (record !== snapshot) return; // 刷新期间用户已修正，以修正结果为准
      record = updated; saveRecord(updated); render(updated);
    }).catch(() => { subtitle.textContent = `${snapshot.result.range} · 行情刷新失败，当前显示已保存快照`; });
  }
</script>

<style>
  .compact-hero { margin-bottom:1rem; }
  .back { display:inline-block; margin-bottom:16px; color:#0369a1; font-size:13px; text-decoration:none; }
  .back:hover { text-decoration:underline; }
  .stats { display:grid; grid-template-columns:repeat(4,1fr); grid-auto-rows:minmax(96px,auto); gap:1px; overflow:hidden; margin-bottom:28px; border:1px solid #e2e8f0; border-radius:10px; background:#e2e8f0; }
  .history h2 { margin:0 0 4px; font-size:18px; }
  .history > p { margin:0 0 12px; color:#64748b; font-size:12px; }
  .history > .sync-note { padding:8px 12px; border:1px solid #fcd34d; border-radius:8px; background:#fffbeb; color:#b45309; }
  .history > .sync-note[hidden] { display:none; }
  .table-shell {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 3px rgb(15 23 42 / .04);
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }
  .table-shell::-webkit-scrollbar { height: 6px; width: 6px; }
  .table-shell::-webkit-scrollbar-track { background: transparent; }
  .table-shell::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 3px; }
  .table-shell::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }
  .chart-panel { margin-top:28px; padding:18px; border:1px solid #e2e8f0; border-radius:10px; background:#fff; }.chart-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:8px; }.chart-head h2 { margin:0 0 3px; color:#1e293b; font-size:16px; }.chart-head p { margin:0; color:#94a3b8; font-size:12px; }.legend { display:flex; flex-wrap:wrap; gap:7px; align-items:center; color:#64748b; font-size:12px; }.line { display:inline-block; width:14px; height:2px; margin-left:5px; }.line.position { background:#2563eb; }.line.capital { background:#f59e0b; }.line.profit { background:#dc2626; }.line.close { background:#7c3aed; }.line.buy-level { border-top:2px dashed #16a34a; }.line.sell-level { border-top:2px dashed #ea580c; }.chart-scroll { overflow-x:auto; }.chart-scroll svg { display:block; width:100%; min-width:680px; height:auto; }
  @media(max-width:640px){.stats{grid-template-columns:repeat(2,1fr)}}
</style>

<style is:global>
  .stats div { padding: 12px 10px; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .stats span { display: block; margin-bottom: 4px; color: #94a3b8; font-size: 12px; transition: color .15s ease; }
  .stats span.warn { color: #d97706 !important; font-weight: 700; }
  .stats strong { display: block; font-size: 19px; font-weight: 700; line-height: 1.25; font-variant-numeric: tabular-nums; color: #1e293b; }
  .stats .step-hint { margin-top: 4px; margin-bottom: 0; font-size: 11px; color: #94a3b8; line-height: 1.3; }
  .stats .step-hint + .step-hint { margin-top: 2px; }
  .stats .up { color: #dc2626 !important; font-weight: 600; }
  .stats .down { color: #16a34a !important; font-weight: 600; }

  .detail-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .detail-table th { height: 46px; padding: 11px 13px; background: #f8fafc; color: #475569; font-size: 12px; font-weight: 600; text-align: center; border-bottom: 1px solid #cbd5e1; white-space: nowrap; }
  .detail-table td { height: 50px; padding: 8px 13px; border-bottom: 1px solid #f1f5f9; text-align: center; vertical-align: middle; white-space: nowrap; font-variant-numeric: tabular-nums; color: #334155; }
  .detail-table tbody tr { transition: background-color .15s ease; }
  .detail-table tbody tr:hover { background-color: #f8fafc; }
  .detail-table tr:last-child td { border-bottom: 0; }
  .detail-table .buy, .detail-table .sell { display: inline-flex; align-items: center; justify-content: center; min-width: 48px; border-radius: 4px; padding: 3px 8px; font-size: 11px; font-weight: 600; }
  .detail-table .buy { background: #fef2f2; color: #dc2626; }
  .detail-table .sell { background: #f0fdf4; color: #16a34a; }
  .detail-table .up { color: #dc2626; font-weight: 600; }
  .detail-table .price-edit { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; }
  .detail-table .price-input { width: 84px; padding: 4px 6px; border: 1px solid transparent; border-radius: 5px; background: transparent; color: inherit; font: inherit; font-variant-numeric: tabular-nums; text-align: center; cursor: text; -moz-appearance: textfield; }
  .detail-table .price-input::-webkit-inner-spin-button, .detail-table .price-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .detail-table .price-input:hover { border-color: #cbd5e1; background: #fff; }
  .detail-table .price-input:focus { outline: none; border-color: #0369a1; background: #fff; box-shadow: 0 0 0 2px rgb(3 105 161 / .15); }
  .detail-table .price-input.adjusted { border-color: #fcd34d; background: #fffbeb; color: #b45309; font-weight: 600; }
  .detail-table .price-input.amount-input { width: 96px; }
  .detail-table .confirm-edit { border: 1px solid #0369a1; border-radius: 4px; padding: 1px 10px; background: #0369a1; color: #fff; font-size: 11px; line-height: 16px; cursor: pointer; }
  .detail-table .confirm-edit:hover { background: #075985; }
  .detail-table .confirm-edit:disabled { opacity: .6; cursor: wait; }
  .detail-table .confirm-edit[hidden] { display: none; }
  .detail-table .down { color: #16a34a; font-weight: 600; }
</style>
