---
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/url';

const savedUrl = href('lab/grid-trading/saved');
---

<Base title="网格回测详情" current="lab" description="网格回测的历史成交明细">
  <header class="hero compact-hero"><p class="kicker">BACKTEST DETAIL</p><h1 id="title">回测详情</h1><p id="subtitle" class="lede">正在读取已保存记录…</p></header>
  <a class="back" id="back-link" href={savedUrl}>← 返回已保存标的</a>
  <section id="stats" class="stats"></section>
  <section class="chart-panel">
    <div class="chart-head"><div><h2>资金与收盘价变化曲线</h2><p>当前标的的历史回测数据；上图价格、下图资金，共用同一条时间轴</p></div><div class="legend axis-legend"><div class="legend-row"><b class="axis-tag tag-price">上图 · 价格</b><span class="line close"></span>收盘价 <span class="line buy-level"></span>预计买入 <span class="line sell-level"></span>预计卖出 <span class="line step-level"></span>步长线</div><div class="legend-row"><b class="axis-tag tag-money">下图 · 资金</b><span class="line position"></span>持仓市值 <span class="line capital"></span>占用本金 <span class="line profit"></span>总盈亏</div></div></div>
    <div class="chart-scroll"><svg id="equity-chart" viewBox="0 0 920 300" role="img" aria-label="当前标的的资金与收盘价变化曲线"><text x="460" y="150" text-anchor="middle" fill="#94a3b8" font-size="13">读取已保存回测数据后显示曲线</text></svg></div>
  </section>
  <section class="backup-panel" aria-label="备份对比">
    <div class="backup-head">
      <div><h2>备份对比</h2><p id="backup-desc">备份当前数据作为基准点。之后你手动微调买卖点（改成交、增删记录、改参数），这里会对比“从备份点起完全按网格买卖”与“你现在的实际数据”的收益差别。</p></div>
      <div class="backup-actions"><select id="backup-select" hidden aria-label="选择备份"></select><a id="backup-view" class="tool-link" hidden>查看备份详情 →</a><button id="backup-delete" class="tool-link" type="button" hidden>删除此备份</button><button id="backup-now" class="tool-button" type="button" disabled>备份当前数据</button></div>
    </div>
    <p id="backup-empty" class="backup-empty">还没有备份。点击右上角“备份当前数据”，以当前状态为起点开始对比。</p>
    <div id="backup-compare" class="backup-compare"></div>
    <div id="compare-chart-block" class="compare-chart-block" hidden>
      <div class="chart-head">
        <div><h3>对比曲线</h3><p>同一指标下，纯网格续跑与当前数据（含手动微调）的走势对比；虚线竖线为备份点，悬停可查看两者的值和差额。</p></div>
        <div class="metric-tabs" role="tablist" aria-label="对比指标"><button type="button" class="active" data-metric="pnl">总盈亏</button><button type="button" data-metric="positionValue">持仓市值</button><button type="button" data-metric="capitalUsed">占用本金</button></div>
      </div>
      <div class="legend"><span class="line pure"></span>纯网格续跑（本备份，含备份视图中的成交修正）<span class="line live"></span>当前数据（含手动微调）</div>
      <div class="chart-scroll"><svg id="compare-chart" viewBox="0 0 920 300" role="img" aria-label="备份与当前数据对比曲线"></svg></div>
    </div>
  </section>
  <section class="history"><h2>历史成交</h2><p id="history-hint">成交价格、成交金额、成交份额可直接修改为真实成交值（如按 100 份整数倍成交），修改份额时金额按“份额 × 成交价”计算；修改后该笔及之后的持仓、盈亏、网格价位会重新计算，并自动同步到云端。持仓市值按该笔成交价估值；“当时占用本金”仅统计成交金额，不含手续费，其最高值与回测摘要中的“最多使用本金”一致。最新成交在最上方。</p>
    <p id="history-hint2">可添加或删除成交记录（建仓不可删除）：添加时填写日期、方向、成交价格和成交份额，其余数据自动计算并按日期排入列表。增删只影响总盈亏、持仓和占用本金，不改动其他成交行；只有最上面（最新）的一条变化时，才会改变下一格买卖价的基准。</p>
    <div class="trade-tools"><button id="add-trade-toggle" class="tool-button" type="button">＋ 添加记录</button><button id="restore-removed" class="tool-link" type="button" hidden></button></div>
    <form id="trade-form" class="trade-form" hidden novalidate>
      <label>日期 <input id="tf-date" type="date" required></label>
      <label>方向 <select id="tf-side"><option value="买入">买入</option><option value="卖出">卖出</option></select></label>
      <label>成交价格 <input id="tf-price" type="number" step="0.001" min="0.001" inputmode="decimal" required></label>
      <label>成交份额 <input id="tf-shares" type="number" step="100" min="1" inputmode="decimal" required></label>
      <span id="tf-preview" class="tf-preview">成交金额 —</span>
      <button id="tf-save" class="tool-primary" type="submit">保存</button>
      <button id="tf-cancel" class="tool-button" type="button">取消</button>
      <span id="tf-error" class="tf-error" role="alert"></span>
    </form>
    <p id="sync-note" class="sync-note" role="status" hidden></p><div class="table-shell"><table class="detail-table"><thead><tr><th>日期</th><th>操作</th><th>成交价格</th><th>成交金额</th><th>成交份额</th><th>成交后持仓份额</th><th>成交后持仓市值</th><th>当时占用本金</th><th>当时总盈亏</th><th>操作</th></tr></thead><tbody id="trades"></tbody></table></div></section>
</Base>

<script>
  import {
    calculateGrid, adjustmentsOf, getCandles, fetchQuotes, mergeQuote, refreshRecord, readRecords, saveRecord, pushRecord,
    renderEquityChart, renderCompareChart, holdingValue, openingOf, createBackup, replayBackup, refreshBackupSnapshot, upgradeBackup, formatMoney, formatAmount, formatPercent, tick,
    blockCopy,
    type SavedRecord, type Trade, type Adjustments, type GridResult, type Backup, type CompareMetric, type EquityPoint,
  } from '../../../lib/grid-trading';

  blockCopy(); // 屏蔽页面内容复制

  type AdjustField = 'price' | 'amount' | 'shares';
  const id = new URLSearchParams(location.search).get('id');
  // 备份视图：详情页加 backup 参数即进入只读的备份视图，展示备份时的数据以及备份日之后完全按网格买卖的走向。
  const backupParam = new URLSearchParams(location.search).get('backup');
  let viewBackup: Backup | undefined;
  // 对比曲线：live 为当前数据（含手动微调）的逐日曲线，pure 为备份视图的纯网格续跑曲线。
  let liveSeries: EquityPoint[] = [], pureSeries: EquityPoint[] = [], compareMetric: CompareMetric = 'pnl', compareBackup: Backup | undefined;
  let viewLiveResult: GridResult | undefined;
  function drawCompare() {
    if (!compareBackup) return;
    renderCompareChart(document.querySelector('#compare-chart') as SVGSVGElement, pureSeries, liveSeries, compareMetric, { date: compareBackup.date, label: '备份点' });
  }
  const backupLabelOf = (backup: { at: string }) => new Date(backup.at).toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16);
  const subtitle = document.querySelector('#subtitle') as HTMLElement;
  const price = (v?: number) => typeof v === 'number' && Number.isFinite(v) ? `¥${v.toFixed(3)}` : '—';
  let record = readRecords().find(item => item.id === id);
  // 用户修改计数：行情刷新期间用户做过修改就丢弃刷新结果；备份规则升级等后台改动不计入。
  let editRevision = 0;

  function showNote(text: string) {
    const note = document.querySelector('#sync-note') as HTMLElement;
    note.textContent = text; note.hidden = !text;
  }

  function render(item: SavedRecord) {
    const { row, result } = item;
    document.querySelector('#title')!.textContent = `${row.name} · ${row.code}`;
    const detailLine = `${result.range} · 初始价 ${openingOf(item).price} · 每格金额 ¥${row.gridAmount.toLocaleString('zh-CN')}`;
    if (viewBackup) {
      const badge = document.createElement('span'); badge.className = 'view-badge'; badge.textContent = '备份视图';
      document.querySelector('#title')!.append(badge);
      subtitle.textContent = `备份于 ${backupLabelOf(viewBackup)} · 备份日 ${viewBackup.date} 之后完全按网格买卖 · ${detailLine}`;
    } else subtitle.textContent = detailLine;
    // 预计买卖价是固定成交价，日内高低价触及即执行。
    const current = result.current;
    const buyReached = current <= result.nextBuy, sellReached = current >= result.nextSell;
    const gap = (target: number) => `距现价 ${formatPercent((target - current) / current)}`;
    const moveLine = (label: string, value: number) => `${label} ¥${value.toFixed(3)} · 占现价 ${(value / current * 100).toFixed(2)}%`;
    const buyHint = [buyReached ? `已达到买入价 ¥${result.nextBuy.toFixed(3)}` : `价格达到 ¥${result.nextBuy.toFixed(3)} 即买入 · ${gap(result.nextBuy)}`, moveLine('反弹', row.rebound)];
    const sellHint = [sellReached ? `已达到卖出价 ¥${result.nextSell.toFixed(3)}` : `价格达到 ¥${result.nextSell.toFixed(3)} 即卖出 · ${gap(result.nextSell)}`, moveLine('回落', row.pullback)];
    const hint = (lines: string[]) => lines.map(line => `<span class="step-hint">${line}</span>`).join('');
    document.querySelector('#stats')!.innerHTML = `
      <div><span>当前价格</span><strong>${price(current)}</strong></div>
      <div><span>上次成交价</span><strong>${price(result.lastTrade)}</strong></div>
      <div><span class="${buyReached ? 'warn' : ''}">预计下次买入</span><strong class="down">${price(result.nextBuy)}</strong>${hint(buyHint)}</div>
      <div><span class="${sellReached ? 'warn' : ''}">预计下次卖出</span><strong class="up">${price(result.nextSell)}</strong>${hint(sellHint)}</div>
      <div><span>总盈亏</span><strong class="${result.pnl >= 0 ? 'up' : 'down'}">${formatMoney(result.pnl)}</strong></div>
      <div><span>持仓市值</span><strong>¥${formatAmount(holdingValue(result))}</strong></div>
      <div><span>最多使用本金</span><strong>¥${formatAmount(result.maxCapital)}</strong></div>
      <div><span>买入 / 卖出</span><strong>${result.buys} / ${result.sells}</strong></div>
    `;
    let derivedCapital = 0;
    const lastIndex = result.trades.length - 1;
    const rows = result.trades.map((t, index) => {
      // 兼容早期保存的记录：没有 capitalUsed 时按成交额反推当时占用本金。
      if (typeof t.capitalUsed === 'number') derivedCapital = t.capitalUsed;
      else if (index === 0) derivedCapital = t.amount;
      else derivedCapital += t.side === '买入' ? t.amount : -t.amount;
      const number2 = (v: number) => v.toLocaleString('zh-CN', { maximumFractionDigits: 2 });
      // 手动记录的价格、金额、份额为只读（错了请删除后重新添加）；网格成交仍可直接修正。
      const readonlyRow = !!t.manual;
      const cells = readonlyRow
        ? `<td>${t.price.toFixed(3)}</td><td>${t.amount.toFixed(2)}</td><td>${Number((t.quantity ?? t.amount / t.price).toFixed(2))}</td>`
        : `<td>${editableCell(t, 'price')}</td><td>${editableCell(t, 'amount')}</td><td>${editableCell(t, 'shares')}</td>`;
      const afterBackup = !!viewBackup && t.date > viewBackup.date;
      const tag = (t.manual ? '<i class="manual-tag">手动</i>' : '') + (afterBackup ? '<i class="after-tag">备份后</i>' : '');
      const action = t.side === '建仓' || viewBackup ? '' : `<button type="button" class="delete-trade" data-kind="${t.manual ? 'manual' : 'grid'}" data-key="${t.manual ? t.id : t.date}" data-top="${index === lastIndex ? '1' : '0'}">删除</button>`;
      return `<tr class="${t.manual ? 'manual-row' : ''}${afterBackup ? ' after-row' : ''}"><td>${t.date}</td><td><b class="${t.side === '卖出' ? 'sell' : 'buy'}">${t.side}</b>${tag}</td>${cells}<td>${number2(t.shares)}</td><td>¥${number2(t.shares * t.price)}</td><td>¥${number2(derivedCapital)}</td><td class="${t.pnl >= 0 ? 'up' : 'down'}">${formatMoney(t.pnl)}</td><td>${action}</td></tr>`;
    });
    document.querySelector('#trades')!.innerHTML = rows.reverse().join('');
    const restore = document.querySelector('#restore-removed') as HTMLButtonElement, removedCount = item.removedTrades?.length ?? 0;
    restore.hidden = !removedCount; restore.textContent = `恢复已删除的 ${removedCount} 条网格成交`;
    renderEquityChart(document.querySelector('#equity-chart') as SVGSVGElement, result.series ?? [], result.nextBuy, result.nextSell, result.trades, viewBackup ? { date: viewBackup.date, label: '备份点' } : undefined, { down: row.step - row.rebound, up: row.step - row.pullback });
    if (!viewBackup) void renderBackups(item);
  }

  // ---------- 备份对比 ----------
  const MAX_BACKUPS = 20;
  let selectedBackupId: string | undefined, backupRun = 0;
  const backupLabel = (backup: { at: string; price: number; pnl: number }) =>
    `${new Date(backup.at).toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16)} · 价格 ${backup.price.toFixed(3)} · 总盈亏 ${formatMoney(backup.pnl)}`;

  // 备份对比：摘要 + 对比表 + 对比曲线。当前详情页（备份 vs 当前）与备份视图共用同一个渲染。
  function showComparison(backup: Backup, pure: GridResult, live: GridResult) {
    const rateOf = (extra: number) => backup.capital > 0 ? extra / backup.capital : undefined;
    const totalRateOf = (pnl: number, maxCapital: number) => maxCapital > 0 ? pnl / maxCapital : undefined;
    const pureExtra = pure.pnl - backup.pnl, liveExtra = live.pnl - backup.pnl;
    const pct = (value?: number) => value === undefined ? '—' : formatPercent(value);
    const tone = (value: number) => `class="${value >= 0 ? 'up' : 'down'}"`;
    const diffMoney = (value: number) => `<span ${tone(value)}>${formatMoney(value)}</span>`;
    const diffPct = (value?: number) => value === undefined ? '—' : `<span ${tone(value)}>${formatPercent(value)}</span>`;
    const minus = (a?: number, b?: number) => a === undefined || b === undefined ? undefined : a - b;
    const shares = (value?: number) => value === undefined ? '—' : Number(value.toFixed(2)).toLocaleString('zh-CN');
    const rows: [string, string, string, string, string][] = [
      ['总盈亏', formatMoney(backup.pnl), formatMoney(pure.pnl), formatMoney(live.pnl), diffMoney(live.pnl - pure.pnl)],
      ['备份后新增盈亏', '—', formatMoney(pureExtra), formatMoney(liveExtra), diffMoney(liveExtra - pureExtra)],
      ['备份后收益率<small>新增盈亏 ÷ 备份时占用本金</small>', '—', pct(rateOf(pureExtra)), pct(rateOf(liveExtra)), diffPct(minus(rateOf(liveExtra), rateOf(pureExtra)))],
      ['总收益率<small>总盈亏 ÷ 最多使用本金</small>', pct(totalRateOf(backup.pnl, backup.maxCapital)), pct(totalRateOf(pure.pnl, pure.maxCapital)), pct(totalRateOf(live.pnl, live.maxCapital)), diffPct(minus(totalRateOf(live.pnl, live.maxCapital), totalRateOf(pure.pnl, pure.maxCapital)))],
      ['备份后 买入 / 卖出', '—', `${pure.buys - backup.buys} / ${pure.sells - backup.sells}`, `${live.buys - backup.buys} / ${live.sells - backup.sells}`, ''],
      ['当前持仓份额', shares(backup.position), shares(pure.position), shares(live.position), ''],
    ];
    const gain = live.pnl - pure.pnl;
    const summary = Math.abs(gain) < 0.005 ? '目前与纯网格没有差别。'
      : `备份以来，手动微调比纯网格<b ${tone(gain)}>${gain >= 0 ? '多赚' : '少赚'} ¥${formatAmount(Math.abs(gain))}</b>${rateOf(liveExtra) !== undefined && rateOf(pureExtra) !== undefined ? `，收益率相差 ${((rateOf(liveExtra)! - rateOf(pureExtra)!) * 100).toFixed(2)} 个百分点` : ''}。`;
    (document.querySelector('#backup-compare') as HTMLElement).innerHTML = `<p class="backup-summary">备份日 ${backup.date} · 备份时价格 ¥${backup.price.toFixed(3)} · 最新价 ¥${live.current.toFixed(3)}　${summary}</p>
      <div class="table-shell"><table class="compare-table"><thead><tr><th></th><th>备份时</th><th>纯网格续跑</th><th>当前（含手动微调）</th><th>差额（当前 − 纯网格）</th></tr></thead><tbody>${rows.map(([name, a, b, c, d]) => `<tr><td>${name}</td><td data-label="备份时">${a}</td><td data-label="纯网格">${b}</td><td data-label="当前">${c}</td><td data-label="差额">${d}</td></tr>`).join('')}</tbody></table></div>`;
    compareBackup = backup; pureSeries = pure.series; liveSeries = live.series;
    (document.querySelector('#compare-chart-block') as HTMLElement).hidden = false;
    drawCompare();
  }

  async function renderBackups(item: SavedRecord) {
    const run = ++backupRun, backups = item.backups ?? [];
    const select = document.querySelector('#backup-select') as HTMLSelectElement, compare = document.querySelector('#backup-compare') as HTMLElement;
    (document.querySelector('#backup-empty') as HTMLElement).hidden = backups.length > 0;
    const viewLink = document.querySelector('#backup-view') as HTMLAnchorElement;
    (document.querySelector('#backup-delete') as HTMLElement).hidden = select.hidden = viewLink.hidden = !backups.length;
    const chartBlock = document.querySelector('#compare-chart-block') as HTMLElement;
    if (!backups.length) { compare.innerHTML = ''; chartBlock.hidden = true; return; }
    const backup = backups.find(entry => entry.id === selectedBackupId) ?? backups[0];
    selectedBackupId = backup.id;
    const viewUrl = new URL(location.href); viewUrl.searchParams.set('backup', backup.id);
    viewLink.href = viewUrl.toString();
    select.innerHTML = backups.map(entry => `<option value="${entry.id}"${entry.id === backup.id ? ' selected' : ''}>${backupLabel(entry)}</option>`).join('');
    compare.innerHTML = '<p class="backup-empty">正在计算纯网格续跑…</p>';
    try {
      // 纯网格：用备份时冻结的输入在最新行情上续跑，备份日之后完全按网格买卖，不含之后的任何手动微调。
      const candles = await loadCandles(item);
      if (run !== backupRun) return; // 已有更新的渲染，丢弃过期结果
      // 备份的快照按旧规则算出时，按当前规则重算并保存（不改动记录的修改时间，也不触发同步）。
      const upgraded = upgradeBackup(backup, candles);
      if (upgraded) { persistBackup(upgraded); void renderBackups(record ?? item); return; }
      const pure = replayBackup(backup, candles);
      showComparison(backup, pure, item.result);
    } catch {
      if (run === backupRun) { compare.innerHTML = '<p class="backup-empty">行情获取失败，暂时无法对比。</p>'; chartBlock.hidden = true; }
    }
  }

  // 只替换某个备份（规则升级重算快照用），不改记录的修改时间。
  function persistBackup(next: Backup) {
    if (!record) return;
    record = { ...record, backups: (record.backups ?? []).map(entry => entry.id === next.id ? next : entry) };
    saveRecord(record);
  }

  // 备份的增删只改记录本身（不需要重算），保存后同步到云端。
  async function saveBackups(mutate: (item: SavedRecord) => SavedRecord) {
    if (!record) return;
    editRevision++;
    record = { ...mutate(record), updatedAt: new Date().toISOString() };
    saveRecord(record);
    render(record);
    showNote('正在同步到云端…');
    showNote(await pushRecord(record));
  }

  function bindBackups() {
    document.querySelector('#backup-now')!.addEventListener('click', () => {
      if (!record) return;
      if ((record.backups?.length ?? 0) >= MAX_BACKUPS) { showNote(`最多保留 ${MAX_BACKUPS} 个备份，请先删除旧备份`); return; }
      const backup = createBackup(record);
      selectedBackupId = backup.id;
      void saveBackups(item => ({ ...item, backups: [backup, ...(item.backups ?? [])] }));
    });
    document.querySelector('#backup-select')!.addEventListener('change', event => {
      selectedBackupId = (event.target as HTMLSelectElement).value;
      if (record) void renderBackups(record);
    });
    document.querySelector('#backup-delete')!.addEventListener('click', () => {
      if (!record || !selectedBackupId || !confirm('确认删除此备份？删除后无法恢复。')) return;
      const id = selectedBackupId; selectedBackupId = undefined;
      void saveBackups(item => ({ ...item, backups: (item.backups ?? []).filter(entry => entry.id !== id) }));
    });
  }

  function editableCell(t: Trade, field: AdjustField) {
    const config = {
      price: { digits: 3, step: '0.001', label: '成交价格', value: t.price, model: t.modelPrice },
      amount: { digits: 2, step: '0.01', label: '成交金额', value: t.amount, model: t.modelAmount },
      // 旧记录没有 quantity，按成交金额 ÷ 成交价反推。
      shares: { digits: 2, step: '100', label: '成交份额', value: t.quantity ?? t.amount / t.price, model: t.modelQuantity },
    }[field];
    const adjusted = typeof config.model === 'number';
    const shown = field === 'shares' ? String(Number(config.value.toFixed(2))) : config.value.toFixed(config.digits);
    return `<span class="price-edit"><input class="price-input${field === 'price' ? '' : ' amount-input'}${adjusted ? ' adjusted' : ''}" type="number" inputmode="decimal" step="${config.step}" min="0.001" value="${shown}" data-date="${t.date}" data-field="${field}" data-digits="${config.digits}" data-original="${Number(shown).toFixed(config.digits)}" aria-label="${t.date} ${config.label}"><button type="button" class="confirm-edit" hidden>确认</button></span>`;
  }

  // 日线（按天缓存）+ 实时报价（60 秒缓存）合并出最新行情。
  async function loadCandles(item: Pick<SavedRecord, 'row'>) {
    return mergeQuote(await getCandles(item.row.code, item.row.date), (await fetchQuotes([item.row.code])).get(item.row.code));
  }

  // 保存修改并重算：用缓存日线立即重算，写入本机后原地刷新，再把该条记录推送到云端（不重载页面）。
  // validate 返回非空文字时表示不允许保存，此时不写入任何数据。
  async function commit(mutate: (item: SavedRecord) => SavedRecord, validate?: (result: GridResult) => string): Promise<string> {
    if (!record) return '';
    const next = mutate(record);
    const candles = await loadCandles(next);
    if (!candles.length) throw new Error('没有可用日线');
    const result = calculateGrid(next.row, candles, adjustmentsOf(next));
    const problem = validate?.(result) ?? '';
    if (problem) return problem;
    editRevision++;
    record = { ...next, updatedAt: new Date().toISOString(), result };
    saveRecord(record);
    render(record);
    showNote('正在同步到云端…');
    showNote(await pushRecord(record));
    return '';
  }

  // 修正网格成交的真实成交价/金额/份额。
  // 在某个成交日写入修正值。金额与份额互相决定，同一笔只保留最后修改的那一项。
  function withOverride(current: Adjustments, field: AdjustField, date: string, value: number): Adjustments {
    const next: Adjustments = { ...current, price: { ...current.price }, amount: { ...current.amount }, shares: { ...current.shares } };
    if (field !== 'price') { delete next.amount![date]; delete next.shares![date]; }
    else delete next.price![date];
    next[field]![date] = value;
    return next;
  }

  async function applyAdjustment(field: AdjustField, date: string, value: number) {
    subtitle.textContent = '正在按修正后的成交数据重新计算…';
    try {
      if (viewBackup) await commitBackup(field, date, value);
      else await commit(item => {
        const next = withOverride(adjustmentsOf(item), field, date, value);
        return { ...item, priceOverrides: next.price, amountOverrides: next.amount, sharesOverrides: next.shares };
      });
    } catch {
      subtitle.textContent = '行情获取失败，修正未保存，请稍后重试';
      if (viewBackup && record) render(backupRecordOf(record, viewBackup, replayBackup(viewBackup, cachedBackupCandles ?? [])));
      else if (record) render(record);
    }
  }

  // 备份视图里的修正：只写入这份备份（记录按网格执行时与系统成交的微小差异），不影响当前数据。
  // 修正的是备份日及之前的成交时，同步刷新“备份时”快照，使对比表与备份视图一致。
  let cachedBackupCandles: Awaited<ReturnType<typeof loadCandles>> | undefined;
  async function commitBackup(field: AdjustField, date: string, value: number) {
    if (!record || !viewBackup) return;
    const candles = cachedBackupCandles = await loadCandles(viewBackup);
    const overrides = withOverride({ price: viewBackup.priceOverrides, amount: viewBackup.amountOverrides, shares: viewBackup.sharesOverrides }, field, date, value);
    let next: Backup = { ...viewBackup, priceOverrides: overrides.price, amountOverrides: overrides.amount, sharesOverrides: overrides.shares };
    if (date <= next.date) next = refreshBackupSnapshot(next, candles);
    const result = replayBackup(next, candles);
    record = { ...record, backups: (record.backups ?? []).map(entry => entry.id === next.id ? next : entry), updatedAt: new Date().toISOString() };
    viewBackup = next;
    saveRecord(record);
    render(backupRecordOf(record, next, result));
    if (viewLiveResult) showComparison(next, result, viewLiveResult);
    showNote('正在同步到云端…');
    showNote(await pushRecord(record));
  }

  // 备份视图用与当前详情页相同的渲染，这里把备份和续跑结果包装成一条记录。
  const backupRecordOf = (source: SavedRecord, backup: Backup, result: GridResult): SavedRecord => ({
    id: source.id, savedAt: backup.at, row: backup.row, result, priceOverrides: backup.priceOverrides, amountOverrides: backup.amountOverrides,
    sharesOverrides: backup.sharesOverrides, paramHistory: backup.paramHistory, manualTrades: backup.manualTrades, removedTrades: backup.removedTrades,
  });

  // 手动增删记录只影响总盈亏、持仓和占用本金：卖出份额不能超过当时持仓，删除也不能让持仓变成负数。
  const positionProblem = (message: string) => (result: GridResult) =>
    (result.position ?? 0) < -1e-6 || result.trades.some(trade => trade.manual && trade.shares < -1e-6) ? message : '';

  function bindTradeTools() {
    const form = document.querySelector('#trade-form') as HTMLFormElement;
    const field = (name: string) => document.querySelector(`#tf-${name}`) as HTMLInputElement;
    const error = document.querySelector('#tf-error') as HTMLElement;
    const preview = document.querySelector('#tf-preview') as HTMLElement;
    const updatePreview = () => {
      const amount = Number(field('price').value) * Number(field('shares').value);
      preview.textContent = amount > 0 ? `成交金额 ¥${formatAmount(amount)}` : '成交金额 —';
    };
    const lastDate = () => record?.result.series?.at(-1)?.date ?? new Date().toISOString().slice(0, 10);
    document.querySelector('#add-trade-toggle')!.addEventListener('click', () => {
      if (!record) return;
      form.hidden = !form.hidden;
      if (form.hidden) return;
      field('date').min = record.row.date; field('date').max = lastDate(); field('date').value = lastDate();
      error.textContent = ''; field('price').focus();
    });
    document.querySelector('#tf-cancel')!.addEventListener('click', () => { form.hidden = true; form.reset(); error.textContent = ''; updatePreview(); });
    form.addEventListener('input', updatePreview);
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!record) return;
      const date = field('date').value, side = (document.querySelector('#tf-side') as HTMLSelectElement).value as '买入' | '卖出';
      const tradePrice = Number(field('price').value), shares = Number(field('shares').value);
      if (!date || date < record.row.date || date > lastDate()) { error.textContent = `日期需在 ${record.row.date} 至 ${lastDate()} 之间`; return; }
      if (!(tradePrice > 0) || !(shares > 0)) { error.textContent = '请填写大于 0 的成交价格和成交份额'; return; }
      const save = document.querySelector('#tf-save') as HTMLButtonElement;
      save.disabled = true; error.textContent = '';
      try {
        const problem = await commit(
          item => ({ ...item, manualTrades: [...(item.manualTrades ?? []), { id: crypto.randomUUID(), date, side, price: tick(tradePrice), shares: Number(shares.toFixed(2)) }] }),
          positionProblem('卖出份额超过当时持仓，无法保存'),
        );
        if (problem) error.textContent = problem;
        else { form.hidden = true; form.reset(); updatePreview(); }
      } catch { error.textContent = '行情获取失败，请稍后重试'; }
      save.disabled = false;
    });

    document.querySelector('#restore-removed')!.addEventListener('click', () => {
      commit(item => ({ ...item, removedTrades: [] })).catch(() => showNote('行情获取失败，请稍后重试'));
    });
    document.querySelector('#trades')!.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest('.delete-trade') as HTMLButtonElement | null;
      if (!button) return;
      const isTop = button.dataset.top === '1', key = button.dataset.key!;
      const tip = `确认删除这条成交记录？\n删除只影响总盈亏、持仓和占用本金，不改动其他成交行。${isTop ? '\n这是最新的一条，删除后下一格买卖价将以上一条成交价为基准。' : ''}`;
      if (!confirm(tip)) return;
      button.disabled = true;
      commit(item => button.dataset.kind === 'manual'
        ? { ...item, manualTrades: (item.manualTrades ?? []).filter(trade => trade.id !== key) }
        : { ...item, removedTrades: [...new Set([...(item.removedTrades ?? []), key])] },
      positionProblem('删除后持仓将变为负数，无法删除'))
        .then(problem => { if (problem) { showNote(problem); button.disabled = false; } })
        .catch(() => { showNote('行情获取失败，请稍后重试'); button.disabled = false; });
    });
  }

  function bindEditing() {
    const table = document.querySelector('#trades') as HTMLElement;
    const inputOf = (target: EventTarget | null) => (target as HTMLElement).closest('.price-input') as HTMLInputElement | null;
    // 输入值与原值不同时显示确认按钮，确认后才保存并重算。
    table.addEventListener('input', event => {
      const input = inputOf(event.target);
      if (!input) return;
      const value = Number(input.value), digits = Number(input.dataset.digits);
      (input.nextElementSibling as HTMLButtonElement).hidden = !(Number.isFinite(value) && value > 0 && value.toFixed(digits) !== input.dataset.original);
    });
    table.addEventListener('keydown', event => {
      const input = inputOf(event.target), key = (event as KeyboardEvent).key;
      if (!input) return;
      const button = input.nextElementSibling as HTMLButtonElement;
      if (key === 'Enter' && !button.hidden) button.click();
      if (key === 'Escape') { input.value = input.dataset.original!; button.hidden = true; input.blur(); }
    });
    table.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest('.confirm-edit') as HTMLButtonElement | null;
      if (!button) return;
      const input = button.previousElementSibling as HTMLInputElement;
      const value = Number(input.value), digits = Number(input.dataset.digits);
      if (!Number.isFinite(value) || value <= 0) return;
      button.disabled = true; button.textContent = '计算中…';
      void applyAdjustment(input.dataset.field as AdjustField, input.dataset.date!, Number(value.toFixed(digits)));
    });
  }

  // 备份视图：只读，不写入任何数据。用备份冻结的输入在最新行情上重算，页面结构与当前详情页完全一致。
  async function showBackupView(source: SavedRecord, backupId: string) {
    const backup = source.backups?.find(entry => entry.id === backupId);
    document.body.classList.add('backup-view');
    const backLink = document.querySelector('#back-link') as HTMLAnchorElement;
    const currentUrl = new URL(location.href); currentUrl.searchParams.delete('backup');
    backLink.href = currentUrl.toString(); backLink.textContent = '← 返回当前数据';
    if (!backup) { document.querySelector('#title')!.textContent = '未找到该备份'; subtitle.textContent = '该备份可能已被删除，或来自另一台浏览器。'; return; }
    viewBackup = backup;
    (document.querySelector('#history-hint') as HTMLElement).textContent = '备份视图展示备份时的数据，以及备份日之后完全按网格买卖的走向（不含此后的手动微调）。标有“备份后”的行是备份之后按网格自动产生的成交。成交价格、成交金额、成交份额可修改，用来记录按网格执行时与系统成交的微小差异，只保存在这份备份里，不影响当前数据；修改备份日及之前的成交会同步刷新对比表中的“备份时”。此处不能增删记录或改参数。持仓市值按该笔成交价估值；“当时占用本金”仅统计成交金额，不含手续费。最新成交在最上方。';
    (document.querySelector('#history-hint2') as HTMLElement).hidden = true;
    subtitle.textContent = '正在计算备份及之后的网格走向…';
    bindEditing();
    try {
      const candles = cachedBackupCandles = await loadCandles(backup);
      const upgraded = upgradeBackup(backup, candles);
      if (upgraded) { viewBackup = upgraded; persistBackup(upgraded); }
      const current = upgraded ?? backup;
      const result = replayBackup(current, candles);
      render(backupRecordOf(record ?? source, current, result));
      // 当前数据：与详情页相同的计算（含手动增删、修正与参数变更），用于和纯网格续跑对比。
      viewLiveResult = calculateGrid(source.row, candles, adjustmentsOf(source));
      (document.querySelector('#backup-desc') as HTMLElement).textContent = '以下为本备份与当前数据的对比（只读），内容与当前详情页的“备份对比”一致。';
      showComparison(current, result, viewLiveResult);
    } catch { subtitle.textContent = '行情获取失败，暂时无法展示备份走向，请稍后重试。'; }
  }

  // 对比曲线的指标切换（当前详情页与备份视图共用）。
  document.querySelectorAll('.metric-tabs button').forEach(button => button.addEventListener('click', () => {
    compareMetric = (button as HTMLElement).dataset.metric as CompareMetric;
    document.querySelectorAll('.metric-tabs button').forEach(item => item.classList.toggle('active', item === button));
    drawCompare();
  }));

  if (!record) {
    document.querySelector('#title')!.textContent = '未找到保存记录';
    subtitle.textContent = '该记录可能已被删除，或来自另一台浏览器。';
  } else if (backupParam) {
    void showBackupView(record, backupParam);
  } else {
    render(record);
    bindEditing();
    bindTradeTools();
    bindBackups();
    // 先显示已保存快照，再用最新行情（日线按天缓存、报价 60 秒缓存）重算并原地更新。
    const snapshot = record, revision = editRevision;
    refreshRecord(snapshot).then(updated => {
      if (editRevision !== revision) return; // 刷新期间用户已修正，以修正结果为准
      // 刷新期间可能已升级备份，保留最新的备份列表。
      record = { ...updated, backups: record?.backups ?? updated.backups }; saveRecord(record); render(record);
    }).catch(() => { subtitle.textContent = `${snapshot.result.range} · 行情刷新失败，当前显示已保存快照`; })
      .finally(() => { (document.querySelector('#backup-now') as HTMLButtonElement).disabled = false; });
  }
</script>

